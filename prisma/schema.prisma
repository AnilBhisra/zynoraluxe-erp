// ZYNORALUXE Jewellery ERP — database schema.
//
// Phase 1: auth, roles, company settings.
// Phase 2: double-entry accounting — Chart of Accounts, Parties
// (Customer/Supplier/Karigar), Vouchers, Journal Entries, Invoice Lines,
// Payment Accounts, GST rates, voucher numbering sequences.
// Phase 3: rough-to-polished diamond manufacturing — Rough Lots/Pieces,
// Diamond (cutting-polishing) Jobs, Polished Receipts, Polished Diamonds,
// an immutable Stock Movement ledger, and a diamond code-numbering
// sequence — all integrated into the Phase 2 accounting engine (new
// Rough/WIP/Polished inventory accounts; Karigar labour payable reuses
// the existing Accounts Payable control account by party).
// Phase 4 (this update): Jewellery Jobs and Jewellery Manufacturing — a
// minimal fungible Metal Stock foundation (Metal/Purity master, Metal
// Purchases, an immutable weight-based Metal Stock Movement ledger),
// Jewellery Jobs that issue metal + Phase 3 polished diamonds + optional
// manual "other material" lines to a Karigar, Jewellery Receipts
// (partial-receipt-safe, multi-output), and Finished Jewellery records —
// all integrated into the same Phase 2/3 accounting and stock-movement
// architecture (new Metal/Scrap/Jewellery-WIP/Finished inventory
// accounts; Karigar labour and added-material payable again reuses the
// existing Accounts Payable control account by party). Polished
// Diamonds gain 3 new terminal statuses for jewellery use
// (ISSUED_TO_JEWELLERY / SET_IN_JEWELLERY / DAMAGED_LOST) and the
// existing Phase 3 StockMovement ledger gains an additive, nullable link
// to a JewelleryJob so a diamond's complete lifecycle stays in ONE
// ledger regardless of which module consumed it.
//
// Phase 5+ models (costing, selling price, profit) are intentionally NOT
// created yet — see ZYNORALUXE_JEWELLERY_ERP_MASTER_PLAN.md section 9, rule 2.
//
// Forward-compat convention: any field representing money, carat, or weight
// MUST use Prisma's `Decimal` type (maps to PostgreSQL NUMERIC), never
// Float, to avoid floating-point rounding errors in accounting figures.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  STAFF
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companySettingsUpdates CompanySettings[] @relation("CompanySettingsUpdatedBy")
  partiesCreated         Party[]           @relation("PartyCreatedBy")
  partiesUpdated         Party[]           @relation("PartyUpdatedBy")
  paymentAccountsCreated PaymentAccount[]  @relation("PaymentAccountCreatedBy")
  vouchersCreated        Voucher[]         @relation("VoucherCreatedBy")
  vouchersCancelled      Voucher[]         @relation("VoucherCancelledBy")

  roughLotsCreated           RoughLot[]        @relation("RoughLotCreatedBy")
  roughPiecesCreated         RoughPiece[]      @relation("RoughPieceCreatedBy")
  diamondJobsCreated         DiamondJob[]      @relation("DiamondJobCreatedBy")
  diamondJobsCancelled       DiamondJob[]      @relation("DiamondJobCancelledBy")
  polishedReceiptsCreated    PolishedReceipt[] @relation("PolishedReceiptCreatedBy")
  polishedDiamondsCreated    PolishedDiamond[] @relation("PolishedDiamondCreatedBy")
  polishedDiamondsRecut      PolishedDiamond[] @relation("PolishedDiamondRecutBy")
  polishedDiamondsMarkedLost PolishedDiamond[] @relation("PolishedDiamondDamagedLostBy")
  stockMovementsCreated      StockMovement[]   @relation("StockMovementCreatedBy")

  metalPuritiesCreated       MetalPurity[]                @relation("MetalPurityCreatedBy")
  metalPuritiesUpdated       MetalPurity[]                @relation("MetalPurityUpdatedBy")
  metalPurchasesCreated      MetalPurchase[]              @relation("MetalPurchaseCreatedBy")
  metalStockMovementsCreated MetalStockMovement[]         @relation("MetalStockMovementCreatedBy")
  jewelleryJobsCreated       JewelleryJob[]               @relation("JewelleryJobCreatedBy")
  jewelleryJobsCancelled     JewelleryJob[]               @relation("JewelleryJobCancelledBy")
  otherMaterialLinesCreated  JewelleryOtherMaterialLine[] @relation("OtherMaterialLineCreatedBy")
  jewelleryReceiptsCreated   JewelleryReceipt[]           @relation("JewelleryReceiptCreatedBy")
  finishedJewelleryCreated   FinishedJewellery[]          @relation("FinishedJewelleryCreatedBy")

  costingSettingsUpdated CostingSettings[]     @relation("CostingSettingsUpdatedBy")
  costSheetsCreated      CostSheet[]           @relation("CostSheetCreatedBy")
  costSheetsUpdated      CostSheet[]           @relation("CostSheetUpdatedBy")
  costSheetsFinalized    CostSheet[]           @relation("CostSheetFinalizedBy")
  costSheetsArchived     CostSheet[]           @relation("CostSheetArchivedBy")
  costSheetAuditEvents   CostSheetAuditEvent[] @relation("CostSheetAuditEventUser")

  finishedJewelleryStockMovementsCreated FinishedJewelleryStockMovement[] @relation("FinishedJewelleryStockMovementCreatedBy")
  finishedJewellerySalesCreated          FinishedJewellerySale[]          @relation("FinishedJewellerySaleCreatedBy")
  finishedJewellerySalesCancelled        FinishedJewellerySale[]          @relation("FinishedJewellerySaleCancelledBy")
  finishedJewelleryReturnsCreated        FinishedJewelleryReturn[]        @relation("FinishedJewelleryReturnCreatedBy")

  polishedPurchasesCreated       PolishedPurchase[]       @relation("PolishedPurchaseCreatedBy")
  polishedPurchasesCancelled     PolishedPurchase[]       @relation("PolishedPurchaseCancelledBy")
  polishedPacketsCreated         PolishedPacket[]         @relation("PolishedPacketCreatedBy")
  polishedPacketMovementsCreated PolishedPacketMovement[] @relation("PolishedPacketMovementCreatedBy")
  diamondProcessesCreated        DiamondProcess[]         @relation("DiamondProcessCreatedBy")
  packetProcessJobsCreated       PacketProcessJob[]       @relation("PacketProcessJobCreatedBy")
  packetProcessJobsCancelled     PacketProcessJob[]       @relation("PacketProcessJobCancelledBy")
  packetProcessReceiptsCreated   PacketProcessReceipt[]   @relation("PacketProcessReceiptCreatedBy")
  packetProcessJobLinesClosed    PacketProcessJobLine[]   @relation("PacketProcessJobLineClosedBy")

  @@map("users")
}

// Version 1 supports exactly one company. A single row is enforced at the
// application layer via a fixed id ("default"); see src/lib/db/company.ts.
model CompanySettings {
  id String @id @default("default")

  companyName             String
  address                 String?
  phone                   String?
  email                   String?
  gstNumber               String?
  // Home state code (GST place-of-supply), e.g. "24" for Gujarat. Used only
  // to SUGGEST CGST+SGST vs IGST on a voucher — never applied silently.
  companyStateCode        String?
  defaultCurrency         String  @default("INR")
  // Financial year start, stored as month/day so it repeats every year.
  financialYearStartMonth Int     @default(4)
  financialYearStartDay   Int     @default(1)

  updatedByUserId String?
  updatedBy       User?   @relation("CompanySettingsUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("company_settings")
}

// ---------------------------------------------------------------------------
// Phase 2 — Accounting
// ---------------------------------------------------------------------------

enum PartyType {
  CUSTOMER
  SUPPLIER
  KARIGAR
  // Phase 7. A Dalal/Broker and a Manufacturer are ordinary parties: their
  // payables are the same Accounts Payable control account by partyId, so
  // the existing Payment Given flow settles them with no new machinery.
  BROKER
  MANUFACTURER
}

enum OpeningBalanceType {
  RECEIVABLE
  PAYABLE
}

model Party {
  id   String    @id @default(cuid())
  name String
  type PartyType

  phone     String?
  email     String?
  gstin     String?
  address   String?
  state     String?
  stateCode String?

  // Snapshot of the balance entered at creation time. The real, current
  // balance is always derived from JournalEntry rows (see
  // src/lib/accounting/reports.ts) — this column is never read as a live
  // balance, only used to post the one-time opening Voucher.
  openingBalance     Decimal            @default(0) @db.Decimal(14, 2)
  openingBalanceType OpeningBalanceType @default(RECEIVABLE)

  isActive Boolean @default(true)

  createdByUserId String?
  createdBy       User?   @relation("PartyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId String?
  updatedBy       User?   @relation("PartyUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vouchers             Voucher[]
  journalEntries       JournalEntry[]
  roughLotsAsSupplier  RoughLot[]     @relation("RoughLotSupplier")
  diamondJobsAsKarigar DiamondJob[]   @relation("DiamondJobKarigar")

  metalPurchasesAsSupplier MetalPurchase[] @relation("MetalPurchaseSupplier")

  polishedPurchasesAsSupplier     PolishedPurchase[] @relation("PolishedPurchaseSupplier")
  polishedPurchasesAsBroker       PolishedPurchase[] @relation("PolishedPurchaseBroker")
  packetProcessJobsAsManufacturer PacketProcessJob[] @relation("PacketProcessJobManufacturer")
  jewelleryJobsAsCustomer         JewelleryJob[]     @relation("JewelleryJobCustomer")
  jewelleryJobsAsKarigar          JewelleryJob[]     @relation("JewelleryJobKarigar")

  costSheetsAsCustomer CostSheet[] @relation("CostSheetCustomer")

  finishedJewellerySalesAsCustomer FinishedJewellerySale[] @relation("FinishedJewellerySaleCustomer")

  @@index([type])
  @@index([name])
  @@map("parties")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

// Chart of Accounts. Seeded idempotently with the fixed system accounts the
// posting engine relies on (see prisma/seed.ts) — `isSystem` accounts are
// not exposed for Owner deletion.
model Account {
  id       String      @id @default(cuid())
  code     String      @unique
  name     String
  type     AccountType
  isSystem Boolean     @default(false)
  isActive Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journalEntries JournalEntry[]
  paymentAccount PaymentAccount?

  @@map("accounts")
}

enum PaymentMethod {
  CASH
  BANK
  UPI
  OTHER
}

model PaymentAccount {
  id     String        @id @default(cuid())
  name   String
  method PaymentMethod

  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id])

  isActive Boolean @default(true)

  createdByUserId String?
  createdBy       User?   @relation("PaymentAccountCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vouchers Voucher[]

  @@map("payment_accounts")
}

// Configurable GST rate master — never hardcoded as legal fact in code.
// Owner manages the list; invoice lines snapshot the percent actually used.
model GstRate {
  id          String  @id @default(cuid())
  label       String
  ratePercent Decimal @db.Decimal(5, 2)
  isActive    Boolean @default(true)
  isSystem    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoiceLines      InvoiceLine[]
  roughLots         RoughLot[]
  metalPurchases    MetalPurchase[]
  polishedPurchases PolishedPurchase[]
  costSheets        CostSheet[]        @relation("CostSheetGstRate")
  costingSettings   CostingSettings[]  @relation("CostingSettingsGstRate")

  @@map("gst_rates")
}

enum VoucherType {
  PURCHASE
  SALE
  PAYMENT_GIVEN
  PAYMENT_RECEIVED
  EXPENSE
  OPENING
  REVERSAL
  DIAMOND_ISSUE
  DIAMOND_RECEIPT
  JEWELLERY_ISSUE
  JEWELLERY_RECEIPT
  // Phase 6 — a Finished Jewellery Sale posts as a plain "SALE" (same
  // reasoning as Rough/Metal Purchase reusing "PURCHASE": no dedicated
  // type, linkage detected via FinishedJewellerySale.voucherId), but its
  // partial, snapshot-computed item-level return and its customer refund
  // are NOT a full mirror-reversal, so each gets its own real type rather
  // than overloading REVERSAL (which the existing cancelVoucher() always
  // interprets as "mirror every original line exactly").
  SALE_RETURN
  CUSTOMER_REFUND
  // Phase 7 — Owner-authorized polished packet count correction. Posted
  // together with its packet ledger movement; never cancelled through the
  // generic voucher flow (an opposite adjustment is the correction).
  STOCK_ADJUSTMENT
}

// Concurrency-safe voucher numbering: one row per (type, financial year),
// incremented via an atomic upsert — see src/lib/accounting/numbering.ts.
model VoucherSequence {
  id                 String      @id @default(cuid())
  voucherType        VoucherType
  financialYearLabel String
  lastNumber         Int         @default(0)

  updatedAt DateTime @updatedAt

  @@unique([voucherType, financialYearLabel])
  @@map("voucher_sequences")
}

enum VoucherStatus {
  POSTED
  CANCELLED
}

enum GstTreatment {
  NONE
  CGST_SGST
  IGST
}

model Voucher {
  id                 String      @id @default(cuid())
  voucherNumber      String      @unique
  voucherType        VoucherType
  date               DateTime
  financialYearLabel String

  partyId String?
  party   Party?  @relation(fields: [partyId], references: [id])

  // Set when this voucher is (or includes) an immediate cash/bank/UPI
  // settlement. Required for Payment Given/Received and Expense; optional
  // for Purchase/Sale (present = paid now, absent = on credit).
  paymentAccountId String?
  paymentAccount   PaymentAccount? @relation(fields: [paymentAccountId], references: [id])

  amount       Decimal @db.Decimal(14, 2)
  currencyCode String  @default("INR")
  exchangeRate Decimal @default(1) @db.Decimal(10, 4)

  referenceNumber String?
  note            String?

  gstTreatment GstTreatment @default(NONE)

  status VoucherStatus @default(POSTED)

  // A CANCELLED voucher is never deleted or edited — cancelling posts an
  // equal-and-opposite REVERSAL voucher and links back here.
  reversalOfVoucherId String?  @unique
  reversalOfVoucher   Voucher? @relation("VoucherReversal", fields: [reversalOfVoucherId], references: [id])
  reversedByVoucher   Voucher? @relation("VoucherReversal")

  cancelledAt        DateTime?
  cancelledByUserId  String?
  cancelledBy        User?     @relation("VoucherCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  cancellationReason String?

  // Set by the client on first render of a create form and re-sent on
  // submit; a unique-constraint hit on retry means "already posted" rather
  // than creating a duplicate voucher. See src/lib/accounting/posting.ts.
  idempotencyKey String? @unique

  createdByUserId String
  createdBy       User   @relation("VoucherCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journalEntries JournalEntry[]
  invoiceLines   InvoiceLine[]

  roughLot            RoughLot?
  diamondJobIssue     DiamondJob?
  polishedReceiptPost PolishedReceipt? @relation("PolishedReceiptPosting")

  metalPurchase        MetalPurchase?
  jewelleryJobIssue    JewelleryJob?
  jewelleryReceiptPost JewelleryReceipt? @relation("JewelleryReceiptPosting")

  // Phase 6 — a Finished Jewellery Sale's own SALE voucher, its (optional)
  // full-cancellation REVERSAL voucher, and a return's SALE_RETURN
  // voucher each link back here one-to-one.
  finishedJewellerySale               FinishedJewellerySale?   @relation("FinishedJewellerySaleVoucher")
  finishedJewellerySaleCancellationOf FinishedJewellerySale?   @relation("FinishedJewellerySaleCancellationVoucher")
  finishedJewelleryReturnPost         FinishedJewelleryReturn? @relation("FinishedJewelleryReturnVoucher")

  polishedPurchase             PolishedPurchase?     @relation("PolishedPurchaseVoucher")
  polishedPurchaseCancellation PolishedPurchase?     @relation("PolishedPurchaseCancellationVoucher")
  packetProcessJobWip          PacketProcessJob?     @relation("PacketProcessJobWip")
  packetProcessReceiptPost     PacketProcessReceipt? @relation("PacketProcessReceiptPosting")

  @@index([voucherType])
  @@index([partyId])
  @@index([date])
  @@index([status])
  @@index([financialYearLabel])
  @@map("vouchers")
}

// One row per debit OR credit leg of a posted voucher. `partyId` is set only
// on the Accounts-Receivable / Accounts-Payable legs, giving each party a
// real sub-ledger without a separately-maintained balance column — see
// src/lib/accounting/reports.ts for how running balances are derived.
model JournalEntry {
  id        String  @id @default(cuid())
  voucherId String
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  partyId String?
  party   Party?  @relation(fields: [partyId], references: [id])

  debit  Decimal @default(0) @db.Decimal(14, 2)
  credit Decimal @default(0) @db.Decimal(14, 2)

  description String?

  createdAt DateTime @default(now())

  @@index([accountId])
  @@index([partyId])
  @@index([voucherId])
  @@map("journal_entries")
}

enum InvoiceUnit {
  PCS
  CT
  GRAM
  OTHER
}

enum TaxType {
  EXCLUSIVE
  INCLUSIVE
}

// Purchase/Sale itemized lines. Financial detail only in Phase 2 — no stock
// movement is created from these; Phase 3 connects real stock later.
model InvoiceLine {
  id        String  @id @default(cuid())
  voucherId String
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  description String
  hsnSac      String?
  quantity    Decimal     @db.Decimal(14, 3)
  unit        InvoiceUnit @default(PCS)
  rate        Decimal     @db.Decimal(14, 2)
  discount    Decimal     @default(0) @db.Decimal(14, 2)

  gstRateId      String?
  gstRate        GstRate? @relation(fields: [gstRateId], references: [id])
  // Snapshot of the rate actually applied — never recomputed if the GstRate
  // master changes later.
  gstRatePercent Decimal  @db.Decimal(5, 2)
  taxType        TaxType  @default(EXCLUSIVE)

  taxableValue Decimal @db.Decimal(14, 2)
  taxAmount    Decimal @db.Decimal(14, 2)
  lineTotal    Decimal @db.Decimal(14, 2)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  @@index([voucherId])
  @@map("invoice_lines")
}

// ---------------------------------------------------------------------------
// Phase 3 — Rough-to-Polished Diamond Manufacturing
// ---------------------------------------------------------------------------
//
// Business model: ZYNORALUXE buys lab-grown ROUGH diamonds (never grows
// them — no CVD/HPHT) and has them cut/polished by a Karigar into a
// standard or custom shape. Two-level stock structure: RoughLot (one
// purchase/parcel) contains one or more RoughPiece rows (individual
// stones). A RoughPiece is always issued to a Karigar as a WHOLE piece
// (never split across two jobs) — "partly/fully issued" is a LOT-level
// derived rollup (see src/lib/diamond/reports.ts), not a stored column.
// Every quantity-affecting transition is paired with an immutable
// StockMovement row; nothing here is ever a manually-editable "available"
// field.

enum DiamondShape {
  ROUND
  OVAL
  PEAR
  EMERALD
  CUSHION
  ELONGATED_CUSHION
  RADIANT
  PRINCESS
  MARQUISE
  ASSCHER
  CUSTOM
}

enum RateBasis {
  PER_CARAT
  FIXED_TOTAL
}

// A piece is issued to a Karigar as a whole (see file header note above),
// so only 4 real states exist at the piece level. The master plan's
// "Partly Issued"/"Fully Issued" labels are a derived LOT-level rollup —
// see getRoughLotStatus() in src/lib/diamond/reports.ts.
enum RoughPieceStatus {
  AVAILABLE
  WITH_KARIGAR
  COMPLETED
  CANCELLED
}

enum DiamondJobStatus {
  ISSUED
  IN_PROGRESS
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
}

enum CertificateStatus {
  NOT_CERTIFIED
  INTERNAL_GRADE
  CERTIFIED
}

// SOLD / ISSUED_TO_JEWELLERY are intentionally NOT modeled yet — the
// master plan requires every status to be backed by a real linked
// transaction, and Sale-of-polished / Jewellery-issue don't exist until
// later phases. RECUT is implemented (Owner-only, no reverse rough flow).
// ISSUED_TO_JEWELLERY / SET_IN_JEWELLERY / DAMAGED_LOST added in Phase 4
// (additive enum values — existing AVAILABLE/RECUT rows are unaffected).
enum PolishedDiamondStatus {
  AVAILABLE
  RECUT
  ISSUED_TO_JEWELLERY
  SET_IN_JEWELLERY
  DAMAGED_LOST
}

// One row per (entityType, calendar year) for human-readable diamond
// codes, incremented atomically the same way VoucherSequence is — see
// src/lib/diamond/numbering.ts.
enum DiamondSequenceType {
  ROUGH_LOT
  ROUGH_PIECE
  DIAMOND_JOB
  POLISHED_RECEIPT
  POLISHED_DIAMOND
  // Phase 7
  POLISHED_PURCHASE
  POLISHED_PACKET
  PACKET_PROCESS_JOB
  PACKET_PROCESS_RECEIPT
}

model DiamondSequence {
  id           String              @id @default(cuid())
  sequenceType DiamondSequenceType
  yearLabel    String
  lastNumber   Int                 @default(0)

  updatedAt DateTime @updatedAt

  @@unique([sequenceType, yearLabel])
  @@map("diamond_sequences")
}

model RoughLot {
  id           String   @id @default(cuid())
  lotCode      String   @unique
  purchaseDate DateTime
  supplierId   String
  supplier     Party    @relation("RoughLotSupplier", fields: [supplierId], references: [id])

  piecesCount       Int
  totalRoughCarat   Decimal   @db.Decimal(10, 3)
  purchaseRate      Decimal   @db.Decimal(14, 4)
  rateBasis         RateBasis
  currencyCode      String    @default("INR")
  exchangeRate      Decimal   @default(1) @db.Decimal(10, 4)
  // Authoritative landed cost in INR (after exchange rate) — every piece's
  // allocatedCost must always sum back to exactly this value.
  totalPurchaseCost Decimal   @db.Decimal(14, 2)

  gstTreatment   GstTreatment @default(NONE)
  gstRateId      String?
  gstRate        GstRate?     @relation(fields: [gstRateId], references: [id])
  gstRatePercent Decimal?     @db.Decimal(5, 2)

  supplierInvoiceRef String?
  notes              String?
  photoAssetId       String?

  voucherId String?  @unique
  voucher   Voucher? @relation(fields: [voucherId], references: [id])

  idempotencyKey String? @unique

  createdByUserId String
  createdBy       User   @relation("RoughLotCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pieces RoughPiece[]

  @@index([supplierId])
  @@index([purchaseDate])
  @@map("rough_lots")
}

model RoughPiece {
  id        String    @id @default(cuid())
  roughCode String    @unique
  lotId     String?
  lot       RoughLot? @relation(fields: [lotId], references: [id])

  // Set when this piece was created from a returned-unused-rough leftover
  // on a polished receipt, instead of from a purchase lot — preserves
  // Rough -> Job -> Receipt -> new-Rough traceability without pretending
  // one of several issued pieces was "the" source (a job may issue many
  // pieces together; the leftover isn't attributable to just one of them).
  returnedFromJobId     String?
  returnedFromJob       DiamondJob?      @relation("JobReturnedPieces", fields: [returnedFromJobId], references: [id])
  returnedFromReceiptId String?
  returnedFromReceipt   PolishedReceipt? @relation("ReceiptReturnedPieces", fields: [returnedFromReceiptId], references: [id])

  carat         Decimal  @db.Decimal(10, 3)
  lengthMm      Decimal? @db.Decimal(8, 3)
  widthMm       Decimal? @db.Decimal(8, 3)
  heightMm      Decimal? @db.Decimal(8, 3)
  colorEstimate String?
  clarityNote   String?
  internalNote  String?
  photoAssetId  String?

  // This piece's share of its lot's (or, for a leftover, its source
  // receipt's) cost. Must always sum exactly back to that total — see
  // src/lib/diamond/allocation.ts. Owner may edit directly only while
  // costLocked is false (before the piece's first issue).
  allocatedCost Decimal          @db.Decimal(14, 2)
  costLocked    Boolean          @default(false)
  status        RoughPieceStatus @default(AVAILABLE)

  createdByUserId String
  createdBy       User   @relation("RoughPieceCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobLinks       DiamondJobPiece[]
  stockMovements StockMovement[]

  @@index([lotId])
  @@index([status])
  @@map("rough_pieces")
}

// Join table so a piece's full issue/return/reissue history survives even
// across multiple different jobs over time (a cancelled-and-returned piece
// can be issued again later to a different Karigar) — required for the
// master plan's Rough -> Job traceability rule.
model DiamondJobPiece {
  id           String     @id @default(cuid())
  jobId        String
  job          DiamondJob @relation(fields: [jobId], references: [id])
  roughPieceId String
  roughPiece   RoughPiece @relation(fields: [roughPieceId], references: [id])

  // Snapshots at issue time (the piece itself never changes after this).
  caratAtIssue Decimal @db.Decimal(10, 3)
  costAtIssue  Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  @@unique([jobId, roughPieceId])
  @@map("diamond_job_pieces")
}

model DiamondJob {
  id      String @id @default(cuid())
  jobCode String @unique

  karigarId String
  karigar   Party  @relation("DiamondJobKarigar", fields: [karigarId], references: [id])

  requiredShape                    DiamondShape
  customShapeName                  String?
  customShapeReferencePhotoAssetId String?
  customShapeMeasurements          String?
  customShapeInstruction           String?

  issueDate           DateTime
  dueDate             DateTime?
  targetPolishedCarat Decimal?  @db.Decimal(10, 3)
  targetLengthMm      Decimal?  @db.Decimal(8, 3)
  targetWidthMm       Decimal?  @db.Decimal(8, 3)
  targetHeightMm      Decimal?  @db.Decimal(8, 3)
  notes               String?

  issuedPiecesCount Int
  issuedRoughCarat  Decimal @db.Decimal(10, 3)
  // Total cost moved Rough Inventory -> Diamond WIP for this job. Never
  // recomputed later — receipts drain remainingWipCost, which must reach
  // exactly 0 when the job completes (see src/lib/diamond/posting.ts).
  issuedCostValue   Decimal @db.Decimal(14, 2)
  remainingWipCost  Decimal @db.Decimal(14, 2)

  // Phase 7 — the Manufacturer process this job performs (null for jobs
  // created before processes existed, which are cutting-polishing jobs).
  // Name and output kind are snapshotted so a later master edit never
  // changes what an old job did. A ROUGH-output process (4P / Laser,
  // HPHT / Grow, Rough Polish) returns processed rough, never polished.
  processId                 String?
  process                   DiamondProcess?           @relation(fields: [processId], references: [id])
  processNameSnapshot       String?
  processOutputKindSnapshot DiamondProcessOutputKind?
  chargeRateBasis           ProcessChargeRateBasis?
  chargeRate                Decimal?                  @db.Decimal(14, 4)

  // Cumulative, updated atomically by each receipt.
  receivedPolishedCarat Decimal @default(0) @db.Decimal(10, 3)
  returnedRoughCarat    Decimal @default(0) @db.Decimal(10, 3)
  totalLabourCharge     Decimal @default(0) @db.Decimal(14, 2)

  status DiamondJobStatus @default(ISSUED)

  cancelledAt        DateTime?
  cancelledByUserId  String?
  cancelledBy        User?     @relation("DiamondJobCancelledBy", fields: [cancelledByUserId], references: [id])
  cancellationReason String?

  // The Dr Diamond WIP / Cr Rough Inventory transfer voucher, posted at
  // issue time.
  wipVoucherId String?  @unique
  wipVoucher   Voucher? @relation(fields: [wipVoucherId], references: [id])

  idempotencyKey String? @unique

  createdByUserId String
  createdBy       User   @relation("DiamondJobCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pieces           DiamondJobPiece[]
  receipts         PolishedReceipt[]
  stockMovements   StockMovement[]
  returnedPieces   RoughPiece[]      @relation("JobReturnedPieces")
  polishedDiamonds PolishedDiamond[]

  @@index([karigarId])
  @@index([status])
  @@map("diamond_jobs")
}

model PolishedReceipt {
  id          String @id @default(cuid())
  receiptCode String @unique

  jobId String
  job   DiamondJob @relation(fields: [jobId], references: [id])

  receiveDate        DateTime
  polishedCount      Int
  totalPolishedCarat Decimal      @db.Decimal(10, 3)
  returnedRoughCarat Decimal      @default(0) @db.Decimal(10, 3)
  // Figures for THIS receipt only (not the job's cumulative totals) —
  // Weight Loss = pending-carat-before-this-receipt - polished - returned;
  // Yield % = polished / pending-carat-before-this-receipt * 100.
  weightLossCarat    Decimal      @db.Decimal(10, 3)
  yieldPercent       Decimal      @db.Decimal(6, 3)
  labourCharge       Decimal      @default(0) @db.Decimal(14, 2)
  shape              DiamondShape
  notes              String?

  // Single balanced voucher: Dr Polished Inventory (resolved cost +
  // labour) [+ Dr Rough Inventory for any returned carat], Cr Diamond WIP
  // (resolved cost), Cr Karigar Payable (labour, if any).
  postingVoucherId String?  @unique
  postingVoucher   Voucher? @relation("PolishedReceiptPosting", fields: [postingVoucherId], references: [id])

  idempotencyKey String? @unique

  createdByUserId String
  createdBy       User   @relation("PolishedReceiptCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())

  outputs        PolishedDiamond[]
  returnedPieces RoughPiece[]      @relation("ReceiptReturnedPieces")

  @@index([jobId])
  @@map("polished_receipts")
}

model PolishedDiamond {
  id           String @id @default(cuid())
  polishedCode String @unique

  receiptId String
  receipt   PolishedReceipt @relation(fields: [receiptId], references: [id])
  jobId     String
  job       DiamondJob      @relation(fields: [jobId], references: [id])

  shape        DiamondShape
  carat        Decimal      @db.Decimal(10, 3)
  lengthMm     Decimal?     @db.Decimal(8, 3)
  widthMm      Decimal?     @db.Decimal(8, 3)
  heightMm     Decimal?     @db.Decimal(8, 3)
  color        String?
  clarity      String?
  cutGrade     String?
  polish       String?
  symmetry     String?
  fluorescence String?

  certificateStatus CertificateStatus @default(NOT_CERTIFIED)
  certLab           String?
  certNumber        String?
  certFileAssetId   String?
  photoAssetId      String?

  // This output's share of the receipt's total resolved cost (polished
  // portion + labour). Must sum exactly back to that total across all of
  // a receipt's outputs — see src/lib/diamond/allocation.ts.
  allocatedCost Decimal @db.Decimal(14, 2)
  costPerCarat  Decimal @db.Decimal(14, 2)

  status PolishedDiamondStatus @default(AVAILABLE)

  recutAt       DateTime?
  recutByUserId String?
  recutBy       User?     @relation("PolishedDiamondRecutBy", fields: [recutByUserId], references: [id])
  recutReason   String?

  // Phase 4: Owner-only abnormal-loss classification during a Jewellery
  // Receipt reconciliation — never set from Phase 3 alone.
  damagedLostAt       DateTime?
  damagedLostByUserId String?
  damagedLostBy       User?     @relation("PolishedDiamondDamagedLostBy", fields: [damagedLostByUserId], references: [id])
  damagedLostReason   String?

  createdByUserId String
  createdBy       User   @relation("PolishedDiamondCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockMovements        StockMovement[]
  jewelleryIssueLines   JewelleryDiamondIssueLine[]
  costSheetDiamondLines CostSheetDiamondLine[]

  @@index([jobId])
  @@index([status])
  @@map("polished_diamonds")
}

// JEWELLERY_* values added in Phase 4 — a polished diamond's complete
// lifecycle (Phase 3 manufacturing through Phase 4 jewellery use) stays
// in this ONE ledger regardless of which module consumed it.
enum StockMovementType {
  ROUGH_PURCHASE_IN
  ROUGH_ISSUE_OUT
  ROUGH_ISSUE_CANCEL_IN
  ROUGH_CONSUMED_OUT
  ROUGH_RETURN_IN
  POLISHED_RECEIVE_IN
  POLISHED_RECUT_OUT
  JEWELLERY_ISSUE_OUT
  JEWELLERY_ISSUE_CANCEL_IN
  JEWELLERY_RETURN_IN
  JEWELLERY_SET_OUT
  JEWELLERY_DAMAGED_LOSS_OUT
}

// Immutable audit ledger. Never updated or deleted after insert — a
// correction is always a new movement (e.g. ROUGH_ISSUE_CANCEL_IN
// reverses a ROUGH_ISSUE_OUT), optionally self-linked via
// reversalOfMovementId. `pieces`/`carat`/`costValue` are always positive
// magnitudes; direction is implied entirely by `type` (…_IN adds to
// stock, …_OUT removes it) — this is the single source every stock/report
// figure in src/lib/diamond/reports.ts derives from.
model StockMovement {
  id   String            @id @default(cuid())
  type StockMovementType

  roughPieceId String?
  roughPiece   RoughPiece? @relation(fields: [roughPieceId], references: [id])

  polishedDiamondId String?
  polishedDiamond   PolishedDiamond? @relation(fields: [polishedDiamondId], references: [id])

  diamondJobId String?
  diamondJob   DiamondJob? @relation(fields: [diamondJobId], references: [id])

  jewelleryJobId String?
  jewelleryJob   JewelleryJob? @relation(fields: [jewelleryJobId], references: [id])

  pieces    Int     @default(1)
  carat     Decimal @db.Decimal(10, 3)
  costValue Decimal @db.Decimal(14, 2)

  sourceDocument String

  reversalOfMovementId String?        @unique
  reversalOfMovement   StockMovement? @relation("MovementReversal", fields: [reversalOfMovementId], references: [id])
  reversedByMovement   StockMovement? @relation("MovementReversal")

  createdByUserId String
  createdBy       User   @relation("StockMovementCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([roughPieceId])
  @@index([polishedDiamondId])
  @@index([diamondJobId])
  @@index([type])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Phase 4 — Jewellery Jobs and Jewellery Manufacturing
// ---------------------------------------------------------------------------
//
// A Jewellery Job issues metal (fungible, weight-based stock — see the
// Metal Stock section below), Phase 3 Polished Diamonds (discrete,
// individually tracked — reuses PolishedDiamond/StockMovement above),
// and optional non-stock-tracked "other material" lines to a Karigar,
// then receives back one or more Finished Jewellery outputs. Workflow:
// Create Job (Draft, no accounting impact) -> Issue Materials (one
// atomic event; posts Dr Jewellery WIP / Cr Metal+Polished Inventory) ->
// Mark In Progress (label only) -> Receive Finished Jewellery (partial
// receipts supported; posts Dr Finished Jewellery Inventory + returns to
// Metal/Scrap/Polished Inventory / Cr Jewellery WIP + Karigar Payable
// for labour) -> Completed once every issued material is resolved.

enum MetalType {
  GOLD
  SILVER
  PLATINUM
  OTHER
  // Phase 7 — Company-owned copper/alloy stock. Its purities carry 0%
  // precious-metal fineness, so it never contributes fine weight; a job
  // tracks it by GROSS weight in its own cost pool (JewelleryJob
  // issuedAlloyGrossWeight / remainingAlloyWipCost).
  ALLOY
}

// Configurable, never a hardcoded legal/purity assumption in code — every
// fine-weight calculation reads `finenessPercent` from this table (or
// from a snapshot column that copied it at the time), never a constant.
// Owner-only to create/edit/deactivate; deactivating never deletes it
// (existing jobs/purchases keep referencing it for history).
model MetalPurity {
  id              String    @id @default(cuid())
  metalType       MetalType
  displayName     String
  finenessPercent Decimal   @db.Decimal(6, 3)
  isActive        Boolean   @default(true)

  createdByUserId String
  createdBy       User    @relation("MetalPurityCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId String?
  updatedBy       User?   @relation("MetalPurityUpdatedBy", fields: [updatedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  metalPurchases      MetalPurchase[]
  metalStockMovements MetalStockMovement[]
  jobsAsTargetPurity  JewelleryJob[]            @relation("JewelleryJobTargetPurity")
  metalIssueLines     JewelleryMetalIssueLine[]
  finishedJewellery   FinishedJewellery[]
  costSheetMetalLines CostSheetMetalLine[]

  @@unique([metalType, displayName])
  @@map("metal_purities")
}

enum MetalRateBasis {
  PER_GROSS_GRAM
  PER_FINE_GRAM
  FIXED_TOTAL
}

// One purchase/receipt event. `fineWeight` is always
// `grossWeight * finenessPercentSnapshot / 100`, computed server-side —
// see src/lib/jewellery/allocation.ts. `finenessPercentSnapshot` is
// copied from MetalPurity at purchase time so a later edit to the master
// never rewrites this purchase's history.
model MetalPurchase {
  id           String   @id @default(cuid())
  purchaseCode String   @unique
  supplierId   String
  supplier     Party    @relation("MetalPurchaseSupplier", fields: [supplierId], references: [id])
  purchaseDate DateTime

  metalType               MetalType
  purityId                String
  purity                  MetalPurity @relation(fields: [purityId], references: [id])
  finenessPercentSnapshot Decimal     @db.Decimal(6, 3)
  grossWeight             Decimal     @db.Decimal(10, 3)
  fineWeight              Decimal     @db.Decimal(10, 3)

  rateBasis    MetalRateBasis
  rate         Decimal        @db.Decimal(14, 4)
  currencyCode String         @default("INR")
  exchangeRate Decimal        @default(1) @db.Decimal(10, 4)

  totalPurchaseCost Decimal @db.Decimal(14, 2)

  gstTreatment   GstTreatment @default(NONE)
  gstRateId      String?
  gstRate        GstRate?     @relation(fields: [gstRateId], references: [id])
  gstRatePercent Decimal?     @db.Decimal(5, 2)

  referenceNumber String?
  notes           String?

  voucherId String?  @unique
  voucher   Voucher? @relation(fields: [voucherId], references: [id])

  idempotencyKey String? @unique

  createdByUserId String
  createdBy       User   @relation("MetalPurchaseCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([purchaseDate])
  @@index([metalType, purityId])
  @@map("metal_purchases")
}

enum MetalStockMovementType {
  PURCHASE_IN
  OPENING_IN
  ISSUE_OUT
  ISSUE_CANCEL_IN
  RETURN_IN
  SCRAP_RETURN_IN
  CONSUMED_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

// Immutable, weight-based audit ledger — metal is fungible (unlike
// discrete Diamond pieces), so stock is derived by summing movements
// grouped by (metalType, purityId), never a manually-editable balance
// column. `grossWeight`/`fineWeight`/`costValue` are always positive
// magnitudes; direction is implied by `type` (…_IN adds to stock,
// …_OUT removes it) — see src/lib/jewellery/reports.ts.
model MetalStockMovement {
  id   String                 @id @default(cuid())
  type MetalStockMovementType

  metalType MetalType
  purityId  String
  purity    MetalPurity @relation(fields: [purityId], references: [id])

  grossWeight Decimal @db.Decimal(10, 3)
  fineWeight  Decimal @db.Decimal(10, 3)
  costValue   Decimal @db.Decimal(14, 2)

  sourceDocument String

  jewelleryJobId String?
  jewelleryJob   JewelleryJob? @relation(fields: [jewelleryJobId], references: [id])

  reversalOfMovementId String?             @unique
  reversalOfMovement   MetalStockMovement? @relation("MetalMovementReversal", fields: [reversalOfMovementId], references: [id])
  reversedByMovement   MetalStockMovement? @relation("MetalMovementReversal")

  createdByUserId String
  createdBy       User   @relation("MetalStockMovementCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([metalType, purityId])
  @@index([jewelleryJobId])
  @@index([type])
  @@map("metal_stock_movements")
}

enum JewelleryType {
  RING
  EARRINGS
  PENDANT
  NECKLACE
  BRACELET
  BANGLE
  CHAIN
  COUPLE_RING
  CUSTOM
}

enum JewelleryJobStatus {
  DRAFT
  MATERIALS_ISSUED
  IN_PROGRESS
  PARTIALLY_RECEIVED
  NEEDS_CORRECTION
  COMPLETED
  CANCELLED
}

// jobCode uses prefix "ZL-JJOB-" (not "ZL-JOB-") deliberately — Phase 3's
// DiamondJob already owns "ZL-JOB-" with its own independent counter;
// reusing the same display prefix here would let a Diamond Job and a
// Jewellery Job show the identical human-readable code, which is exactly
// the kind of ambiguity these codes exist to prevent. See
// src/lib/jewellery/numbering.ts.
model JewelleryJob {
  id      String @id @default(cuid())
  jobCode String @unique

  customerId        String?
  customer          Party?  @relation("JewelleryJobCustomer", fields: [customerId], references: [id])
  customerReference String?

  jewelleryType      JewelleryType
  designName         String
  designImageAssetId String?

  karigarId String
  karigar   Party  @relation("JewelleryJobKarigar", fields: [karigarId], references: [id])

  issueDate            DateTime
  expectedDeliveryDate DateTime?
  notes                String?

  jewellerySize        String?
  quantity             Int          @default(1)
  targetMetalType      MetalType?
  targetPurityId       String?
  targetPurity         MetalPurity? @relation("JewelleryJobTargetPurity", fields: [targetPurityId], references: [id])
  targetFinishedWeight Decimal?     @db.Decimal(10, 3)
  specialInstructions  String?

  status JewelleryJobStatus @default(DRAFT)

  // Cumulative snapshots at issue time (never recomputed later).
  issuedMetalFineWeight   Decimal @default(0) @db.Decimal(10, 3)
  issuedMetalCost         Decimal @default(0) @db.Decimal(14, 2)
  issuedDiamondCost       Decimal @default(0) @db.Decimal(14, 2)
  // Phase 7 — polished PACKET diamonds issued to this job (bulk melee by
  // pieces + carat), separate from issuedDiamondCost which covers discrete
  // individually-costed Phase 3 stones.
  issuedPacketDiamondCost Decimal @default(0) @db.Decimal(14, 2)
  otherMaterialCost       Decimal @default(0) @db.Decimal(14, 2)

  // Cumulative, updated atomically by each receipt.
  receivedFineWeight      Decimal @default(0) @db.Decimal(10, 3)
  returnedMetalFineWeight Decimal @default(0) @db.Decimal(10, 3)
  scrapFineWeight         Decimal @default(0) @db.Decimal(10, 3)
  karigarAddedFineWeight  Decimal @default(0) @db.Decimal(10, 3)
  karigarAddedCost        Decimal @default(0) @db.Decimal(14, 2)

  // Phase 7 — Company-owned Copper/Alloy (MetalType ALLOY, 0% fineness)
  // issued to this job. Tracked by GROSS weight in its own cost pool,
  // separate from remainingWipCost (which is fine-bearing metal only and
  // drains by fine weight). Pending alloy = issued − consumed − returned.
  issuedAlloyGrossWeight   Decimal @default(0) @db.Decimal(10, 3)
  issuedAlloyCost          Decimal @default(0) @db.Decimal(14, 2)
  consumedAlloyGrossWeight Decimal @default(0) @db.Decimal(10, 3)
  returnedAlloyGrossWeight Decimal @default(0) @db.Decimal(10, 3)
  remainingAlloyWipCost    Decimal @default(0) @db.Decimal(14, 2)

  // Drains to exactly 0 as receipts resolve it — mirrors DiamondJob's
  // remainingWipCost (see src/lib/diamond/posting.ts for the pattern).
  // Phase 7: fine-bearing metal only — Company alloy has its own pool above.
  remainingWipCost  Decimal @default(0) @db.Decimal(14, 2)
  totalLabourCharge Decimal @default(0) @db.Decimal(14, 2)

  cancelledAt        DateTime?
  cancelledByUserId  String?
  cancelledBy        User?     @relation("JewelleryJobCancelledBy", fields: [cancelledByUserId], references: [id])
  cancellationReason String?

  // The Dr Jewellery WIP / Cr Metal+Polished Inventory transfer voucher,
  // posted once at Issue Materials time.
  wipVoucherId String?  @unique
  wipVoucher   Voucher? @relation(fields: [wipVoucherId], references: [id])

  idempotencyKey String? @unique

  createdByUserId String
  createdBy       User   @relation("JewelleryJobCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  metalIssueLines           JewelleryMetalIssueLine[]
  diamondIssueLines         JewelleryDiamondIssueLine[]
  packetIssueLines          JewelleryPacketIssueLine[]
  packetMovements           PolishedPacketMovement[]
  packetProcessReceiptLines PacketProcessReceiptLine[]
  otherMaterialLines        JewelleryOtherMaterialLine[]
  receipts                  JewelleryReceipt[]
  finishedJewellery         FinishedJewellery[]
  metalStockMovements       MetalStockMovement[]
  stockMovements            StockMovement[]

  @@index([karigarId])
  @@index([customerId])
  @@index([status])
  @@map("jewellery_jobs")
}

// One row per metal line issued to a job. A job may hold several (e.g.
// main metal + alloy) — the normal form shows one; "Add material" adds
// more. Fungible, so unlike a Diamond piece there is no per-line return;
// returns/scrap are tracked cumulatively at the job level instead.
model JewelleryMetalIssueLine {
  id    String       @id @default(cuid())
  jobId String
  job   JewelleryJob @relation(fields: [jobId], references: [id])

  metalType               MetalType
  purityId                String
  purity                  MetalPurity @relation(fields: [purityId], references: [id])
  finenessPercentSnapshot Decimal     @db.Decimal(6, 3)
  grossWeight             Decimal     @db.Decimal(10, 3)
  fineWeight              Decimal     @db.Decimal(10, 3)
  costValue               Decimal     @db.Decimal(14, 2)

  issueDate DateTime
  createdAt DateTime @default(now())

  @@index([jobId])
  @@map("jewellery_metal_issue_lines")
}

enum JewelleryDiamondResolution {
  SET
  RETURNED
  DAMAGED_LOST
}

// Join table so a diamond's full issue/return/reissue history survives
// even across a cancel-and-reissue-elsewhere cycle — same reasoning as
// Phase 3's DiamondJobPiece. `resolvedAs` stays null while the diamond
// is still with the Karigar, unresolved; once set, it can never change
// again (each diamond ends in EXACTLY one terminal state).
model JewelleryDiamondIssueLine {
  id    String       @id @default(cuid())
  jobId String
  job   JewelleryJob @relation(fields: [jobId], references: [id])

  polishedDiamondId String
  polishedDiamond   PolishedDiamond @relation(fields: [polishedDiamondId], references: [id])

  caratAtIssue Decimal @db.Decimal(10, 3)
  costAtIssue  Decimal @db.Decimal(14, 2)

  resolvedAs JewelleryDiamondResolution?
  resolvedAt DateTime?

  setInFinishedJewelleryId String?
  setInFinishedJewellery   FinishedJewellery? @relation(fields: [setInFinishedJewelleryId], references: [id])

  createdAt DateTime @default(now())

  @@unique([jobId, polishedDiamondId])
  @@index([jobId])
  @@index([polishedDiamondId])
  @@map("jewellery_diamond_issue_lines")
}

// Explicitly NOT stock-tracked (no movement ledger) — a simple manual
// cost/documentation line for material that has no real inventory
// system yet (moissanite, small stones, findings, alloy, etc.). Never
// presented in the UI as if it were inventory-traced.
model JewelleryOtherMaterialLine {
  id    String       @id @default(cuid())
  jobId String
  job   JewelleryJob @relation(fields: [jobId], references: [id])

  description String
  quantity    Decimal     @db.Decimal(10, 3)
  unit        InvoiceUnit @default(PCS)
  weight      Decimal?    @db.Decimal(10, 3)
  cost        Decimal     @db.Decimal(14, 2)
  note        String?

  createdByUserId String
  createdBy       User   @relation("OtherMaterialLineCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([jobId])
  @@map("jewellery_other_material_lines")
}

model JewelleryReceipt {
  id          String       @id @default(cuid())
  receiptCode String       @unique
  jobId       String
  job         JewelleryJob @relation(fields: [jobId], references: [id])
  receiveDate DateTime

  returnedMetalGrossWeight Decimal @default(0) @db.Decimal(10, 3)
  returnedMetalFineWeight  Decimal @default(0) @db.Decimal(10, 3)
  scrapGrossWeight         Decimal @default(0) @db.Decimal(10, 3)
  scrapFineWeight          Decimal @default(0) @db.Decimal(10, 3)
  // Only meaningful/non-zero on the receipt that resolves the job's
  // material completely — see the gap/isFinal pattern in
  // src/lib/jewellery/posting.ts (same design as Phase 3's weight loss).
  processLossFineWeight    Decimal @default(0) @db.Decimal(10, 3)
  isAbnormalLoss           Boolean @default(false)
  abnormalLossReason       String?

  karigarAddedFineWeight Decimal @default(0) @db.Decimal(10, 3)
  karigarAddedCost       Decimal @default(0) @db.Decimal(14, 2)

  // Phase 7 — Alloy Added in this receipt's outputs, split by source. The
  // three gross weights always total exactly the alloy computed from the
  // outputs (net weight not explained by consumed issued metal — see
  // src/lib/jewellery/metalMath.ts computeOutputMetal).
  companyAlloyGrossWeight  Decimal @default(0) @db.Decimal(10, 3)
  // Company alloy pool cost moved into finished jewellery by this receipt
  // (consumed alloy, plus any normal alloy loss absorbed on a final receipt).
  companyAlloyCost         Decimal @default(0) @db.Decimal(14, 2)
  karigarAlloyGrossWeight  Decimal @default(0) @db.Decimal(10, 3)
  // Posted once, with this receipt: Dr Finished Jewellery Inventory / Cr AP (Karigar).
  karigarAlloyCost         Decimal @default(0) @db.Decimal(14, 2)
  includedAlloyGrossWeight Decimal @default(0) @db.Decimal(10, 3)
  returnedAlloyGrossWeight Decimal @default(0) @db.Decimal(10, 3)
  alloyLossGrossWeight     Decimal @default(0) @db.Decimal(10, 3)
  // Cost this receipt resolved with no finished output to carry it (a
  // returns-only final receipt's unabsorbable loss, or charges on a receipt
  // with no output) — expensed to Business Expenses instead of leaving
  // value in Finished Jewellery Inventory with no item behind it.
  unabsorbedCost           Decimal @default(0) @db.Decimal(14, 2)

  labourCharge  Decimal @default(0) @db.Decimal(14, 2)
  makingCharge  Decimal @default(0) @db.Decimal(14, 2)
  settingCharge Decimal @default(0) @db.Decimal(14, 2)
  platingCharge Decimal @default(0) @db.Decimal(14, 2)
  otherExpense  Decimal @default(0) @db.Decimal(14, 2)

  notes String?

  postingVoucherId String?  @unique
  postingVoucher   Voucher? @relation("JewelleryReceiptPosting", fields: [postingVoucherId], references: [id])

  idempotencyKey String? @unique

  createdByUserId String
  createdBy       User   @relation("JewelleryReceiptCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())

  outputs           FinishedJewellery[]
  packetResolutions JewelleryPacketResolution[]

  @@index([jobId])
  @@map("jewellery_receipts")
}

enum QcStatus {
  PASSED
  NEEDS_CORRECTION
  REJECTED
}

// Completed jewellery output. Phase 6 connects this to Sale/Stock/COGS —
// see `status` and the FinishedJewelleryStockMovement ledger below.
model FinishedJewellery {
  id           String @id @default(cuid())
  finishedCode String @unique

  receiptId String
  receipt   JewelleryReceipt @relation(fields: [receiptId], references: [id])
  jobId     String
  job       JewelleryJob     @relation(fields: [jobId], references: [id])

  jewelleryType JewelleryType
  description   String?
  quantity      Int           @default(1)
  grossWeight   Decimal?      @db.Decimal(10, 3)

  netMetalWeight          Decimal     @db.Decimal(10, 3)
  metalType               MetalType
  purityId                String
  purity                  MetalPurity @relation(fields: [purityId], references: [id])
  finenessPercentSnapshot Decimal     @db.Decimal(6, 3)
  fineMetalWeight         Decimal     @db.Decimal(10, 3)

  // Phase 7 — the output's purity (above) is an ATTRIBUTE of the finished
  // piece; the metal actually consumed is the job's issued SOURCE purity,
  // snapshotted here (e.g. 24K issued, 18K output). For a same-purity
  // output both snapshots name the same purity. Nullable: rows created
  // before Phase 7 predate this record and are left untouched.
  sourcePurityDisplayNameSnapshot String?
  sourceFinenessPercentSnapshot   Decimal? @db.Decimal(6, 3)
  // Net weight not explained by consumed source metal (e.g. copper added to
  // 24K to make 18K), and its real cost share — alloyCost is already
  // INCLUDED inside metalCost below; stored separately for display only.
  alloyAddedWeight                Decimal  @default(0) @db.Decimal(10, 3)
  alloyCost                       Decimal  @default(0) @db.Decimal(14, 2)

  // Allocated across outputs when a receipt has more than one — see
  // src/lib/jewellery/allocation.ts. Always sums exactly back to the
  // receipt's resolved total.
  //
  // IMPORTANT (Phase 6 audit finding — see PHASE_6_VERIFICATION.md §1):
  // `otherMaterialCost` is DISPLAY-ONLY. It is never posted through
  // accounting at either Issue Materials time or Receive time (confirmed
  // in src/lib/jewellery/posting.ts — the other-material lines create no
  // stock movement and no journal line at issue; `finishedInventoryDebit`
  // at receive time is `finishedPortionCost + totalCharges + setDiamondCost`
  // only). The authoritative accounting inventory carrying cost for ANY
  // Phase 6 COGS/inventory posting is therefore ALWAYS
  // `metalCost + diamondCost + labourAllocated`
  // (equivalently `totalCost - otherMaterialCost`) — NEVER `totalCost`
  // itself. Phase 6 never reads `totalCost` for COGS; it is preserved
  // here unchanged, still correct for Phase 5 Costing's own full
  // business-costing purposes, which legitimately does want
  // otherMaterialCost included.
  metalCost         Decimal @default(0) @db.Decimal(14, 2)
  diamondCost       Decimal @default(0) @db.Decimal(14, 2)
  otherMaterialCost Decimal @default(0) @db.Decimal(14, 2)
  labourAllocated   Decimal @default(0) @db.Decimal(14, 2)
  totalCost         Decimal @default(0) @db.Decimal(14, 2)

  photoAssetId String?
  qcStatus     QcStatus @default(PASSED)
  notes        String?

  // Phase 6. Derived-but-stored (same pattern as RoughPiece.status /
  // PolishedDiamond.status): the FinishedJewelleryStockMovement ledger
  // below is the immutable audit trail; this column is the fast,
  // concurrency-safe gate a Sale's atomic conditional UPDATE checks
  // against (`UPDATE ... WHERE status = 'AVAILABLE'`), not merely a
  // pre-check read in application code — see
  // src/lib/jewellery/finishedSalesPosting.ts.
  status FinishedJewelleryStockStatus @default(AVAILABLE)

  createdByUserId String
  createdBy       User   @relation("FinishedJewelleryCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())

  diamonds          JewelleryDiamondIssueLine[]
  packetResolutions JewelleryPacketResolution[]
  costSheets        CostSheet[]
  stockMovements    FinishedJewelleryStockMovement[]
  saleLines         FinishedJewellerySaleLine[]

  @@index([jobId])
  @@index([receiptId])
  @@index([status])
  @@map("finished_jewellery")
}

// ---------------------------------------------------------------------------
// Phase 6 — Finished Jewellery Sales, Stock, COGS and Actual P&L
// ---------------------------------------------------------------------------
//
// See PHASE_6_VERIFICATION.md for the full design writeup and the source
// audit that shaped it. Short version:
//
//  - Every FinishedJewellery output enters this ledger exactly once, via a
//    PRODUCED_IN movement created atomically inside
//    src/lib/jewellery/posting.ts's receiveFinishedJewellery (and, for any
//    output that already existed before this migration, an idempotent
//    backfill script — see scripts/backfillFinishedJewelleryStock.ts).
//  - `FinishedJewellery.status` is the fast, concurrency-safe gate a Sale
//    checks with an atomic conditional UPDATE
//    (`WHERE status = 'AVAILABLE'`); this ledger is the immutable audit
//    trail, mirroring StockMovement/MetalStockMovement's own established
//    pattern in this codebase.
//  - `costValue` on every movement is ALWAYS the authoritative accounting
//    inventory cost (`metalCost + diamondCost + labourAllocated` —
//    NEVER `totalCost`, which wrongly includes display-only
//    `otherMaterialCost` — see the comment on FinishedJewellery above).

enum FinishedJewelleryStockStatus {
  AVAILABLE
  SOLD
  // A damaged/not-for-resale return lands here, permanently out of the
  // sellable pool — never AVAILABLE again from this status. There is no
  // separate "returned sellable" status: that transition goes straight
  // back to AVAILABLE, since a sellable-returned piece is, from the
  // stock ledger's point of view, simply available again.
  RETURNED_DAMAGED
}

enum FinishedJewelleryStockMovementType {
  PRODUCED_IN
  SOLD_OUT
  SALE_CANCELLED_IN
  RETURNED_SELLABLE_IN
  // Despite the "_OUT" suffix (kept for naming consistency with the other
  // event types, not renamed post-launch to avoid an enum-rename migration
  // on the live database), this event's AVAILABILITY delta is ZERO, not
  // -1 — the item already left the Available pool via its own earlier
  // SOLD_OUT movement. A damaged return only reclassifies an
  // already-unavailable item's terminal lifecycle status (Sold ->
  // Returned-Damaged) and its cost (COGS -> Damaged Jewellery Loss); it
  // never removes the same physical item from stock a second time. See
  // AVAILABILITY_DELTA in src/lib/jewellery/finishedSalesPosting.ts and
  // PHASE_6_VERIFICATION.md §6 for the full reconciliation proof.
  RETURNED_DAMAGED_OUT
  // Owner-only, exceptional, fully audited (reason required at the
  // application layer) — see finishedStockAdjustmentAction. Never used by
  // any normal Sale/Return/Cancel flow.
  OWNER_ADJUSTMENT_IN
  OWNER_ADJUSTMENT_OUT
}

// Immutable, append-only — never updated or deleted after insert, same
// principle as StockMovement/MetalStockMovement. `pieces`/`costValue` are
// always positive magnitudes; direction is implied entirely by `type`
// (…_IN adds to available stock or reinstates it, …_OUT removes it) —
// this is the single source of truth the Finished Stock UI and reports
// derive from, never a manually-editable balance.
model FinishedJewelleryStockMovement {
  id   String                             @id @default(cuid())
  type FinishedJewelleryStockMovementType

  finishedJewelleryId String
  finishedJewellery   FinishedJewellery @relation(fields: [finishedJewelleryId], references: [id])

  pieces    Int     @default(1)
  costValue Decimal @db.Decimal(14, 2)

  // Identity snapshot at the moment of THIS movement — immutable,
  // independent of any later edit to the FinishedJewellery row or its
  // Metal/Purity master, so history can never be silently rewritten.
  finishedCodeSnapshot      String
  jewelleryTypeSnapshot     JewelleryType
  metalTypeSnapshot         MetalType
  purityDisplayNameSnapshot String
  netMetalWeightSnapshot    Decimal       @db.Decimal(10, 3)
  fineMetalWeightSnapshot   Decimal       @db.Decimal(10, 3)
  totalCaratSnapshot        Decimal       @default(0) @db.Decimal(10, 3)
  jobCodeSnapshot           String

  saleId String?
  sale   FinishedJewellerySale? @relation(fields: [saleId], references: [id])

  returnId String?
  return   FinishedJewelleryReturn? @relation(fields: [returnId], references: [id])

  sourceDocument String

  reversalOfMovementId String?                         @unique
  reversalOfMovement   FinishedJewelleryStockMovement? @relation("FinishedJewelleryMovementReversal", fields: [reversalOfMovementId], references: [id])
  reversedByMovement   FinishedJewelleryStockMovement? @relation("FinishedJewelleryMovementReversal")

  createdByUserId String
  createdBy       User   @relation("FinishedJewelleryStockMovementCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([finishedJewelleryId])
  @@index([type])
  @@index([saleId])
  @@index([returnId])
  @@map("finished_jewellery_stock_movements")
}

enum FinishedJewellerySaleStatus {
  POSTED
  CANCELLED
}

// One row per Finished Jewellery Sale — a thin domain wrapper around a
// plain "SALE" Voucher (same reuse pattern as Rough/Metal Purchase
// reusing "PURCHASE": no dedicated VoucherType; linkage is this table's
// own voucherId). The generic cancelVoucherAction is blocked for any
// SALE voucher this table references — see src/app/actions/vouchers.ts.
model FinishedJewellerySale {
  id       String @id @default(cuid())
  saleCode String @unique

  customerId String
  customer   Party  @relation("FinishedJewellerySaleCustomer", fields: [customerId], references: [id])

  saleDate DateTime

  voucherId String  @unique
  voucher   Voucher @relation("FinishedJewellerySaleVoucher", fields: [voucherId], references: [id])

  gstTreatment GstTreatment @default(NONE)

  // Snapshot totals at post time — always re-derivable from `lines`, kept
  // here as a fast, consistent read for lists/reports (same "store the
  // total, derive from lines when it matters" pattern InvoiceLine/Voucher
  // already use elsewhere in this codebase).
  subtotal      Decimal @db.Decimal(14, 2)
  discountTotal Decimal @default(0) @db.Decimal(14, 2)
  taxableTotal  Decimal @db.Decimal(14, 2)
  taxTotal      Decimal @default(0) @db.Decimal(14, 2)
  grandTotal    Decimal @db.Decimal(14, 2)
  // Sum of every line's own cogsAmount — the authoritative accounting
  // inventory cost moved out for this whole sale.
  cogsTotal     Decimal @db.Decimal(14, 2)

  status FinishedJewellerySaleStatus @default(POSTED)

  cancelledAt           DateTime?
  cancelledByUserId     String?
  cancelledBy           User?     @relation("FinishedJewellerySaleCancelledBy", fields: [cancelledByUserId], references: [id])
  cancellationReason    String?
  cancellationVoucherId String?   @unique
  cancellationVoucher   Voucher?  @relation("FinishedJewellerySaleCancellationVoucher", fields: [cancellationVoucherId], references: [id])

  idempotencyKey String? @unique

  createdByUserId String
  createdBy       User   @relation("FinishedJewellerySaleCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())

  lines          FinishedJewellerySaleLine[]
  stockMovements FinishedJewelleryStockMovement[]
  returns        FinishedJewelleryReturn[]

  @@index([customerId])
  @@index([status])
  @@map("finished_jewellery_sales")
}

enum FinishedJewellerySaleLineReturnStatus {
  NONE
  RETURNED_SELLABLE
  RETURNED_DAMAGED
}

// One row per sold item. A sale of N pieces has N lines, each pointing at
// exactly one FinishedJewellery (never split further — Phase 4 never
// produces a divisible output). Every money figure here is a FROZEN
// snapshot: a later return, or any report, must always compute from
// THESE stored figures, never by re-deriving from current GST
// rates/prices/masters/Costing settings.
model FinishedJewellerySaleLine {
  id     String                @id @default(cuid())
  saleId String
  sale   FinishedJewellerySale @relation(fields: [saleId], references: [id])

  finishedJewelleryId String
  finishedJewellery   FinishedJewellery @relation(fields: [finishedJewelleryId], references: [id])

  itemDescriptionSnapshot String

  sellingPrice   Decimal @db.Decimal(14, 2)
  discountShare  Decimal @default(0) @db.Decimal(14, 2)
  taxableValue   Decimal @db.Decimal(14, 2)
  gstRatePercent Decimal @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal @default(0) @db.Decimal(14, 2)
  lineTotal      Decimal @db.Decimal(14, 2)
  // The authoritative accounting inventory cost this specific line moved
  // from Finished Jewellery Inventory to COGS — snapshotted from
  // FinishedJewellery.metalCost + diamondCost + labourAllocated at the
  // moment of sale (see the header comment on FinishedJewellery).
  cogsAmount     Decimal @db.Decimal(14, 2)

  returnStatus FinishedJewellerySaleLineReturnStatus @default(NONE)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  returnLine FinishedJewelleryReturnLine?

  // One unreturned sale line per (sale, item) — the same item CAN appear
  // in a later, separate sale after a legitimate sellable return (a new
  // FinishedJewellerySale row, hence a new saleId), so this is not a
  // blanket "never sold twice" constraint by itself — that guarantee
  // comes from the atomic conditional status UPDATE at sale-posting time
  // (see finishedSalesPosting.ts). This constraint exists to make a
  // buggy caller that tries to add the same item twice to ONE sale's
  // line list fail loudly at the database level.
  @@unique([saleId, finishedJewelleryId])
  @@index([finishedJewelleryId])
  @@map("finished_jewellery_sale_lines")
}

// One row per return event (an Owner may return several items from one
// sale across several separate visits — each is its own
// FinishedJewelleryReturn, its own voucher, its own audit trail).
model FinishedJewelleryReturn {
  id         String                @id @default(cuid())
  returnCode String                @unique
  saleId     String
  sale       FinishedJewellerySale @relation(fields: [saleId], references: [id])
  returnDate DateTime

  voucherId String  @unique
  voucher   Voucher @relation("FinishedJewelleryReturnVoucher", fields: [voucherId], references: [id])

  reason String

  idempotencyKey String? @unique

  createdByUserId String
  createdBy       User   @relation("FinishedJewelleryReturnCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())

  lines          FinishedJewelleryReturnLine[]
  stockMovements FinishedJewelleryStockMovement[]

  @@index([saleId])
  @@map("finished_jewellery_returns")
}

enum FinishedJewelleryReturnDisposition {
  SELLABLE
  DAMAGED
}

// One row per returned line. `saleLineId` is UNIQUE — a database-enforced
// invariant (not just an application check) that the same sold item can
// never be returned twice.
model FinishedJewelleryReturnLine {
  id       String                  @id @default(cuid())
  returnId String
  return   FinishedJewelleryReturn @relation(fields: [returnId], references: [id])

  saleLineId String                    @unique
  saleLine   FinishedJewellerySaleLine @relation(fields: [saleLineId], references: [id])

  disposition FinishedJewelleryReturnDisposition

  // Reversal amounts — copied FROM the original sale line's own frozen
  // figures (never recomputed against current rates/prices), so a return
  // always reverses EXACTLY what was originally charged.
  reversedTaxableValue Decimal @db.Decimal(14, 2)
  reversedTaxAmount    Decimal @default(0) @db.Decimal(14, 2)
  reversedTotal        Decimal @db.Decimal(14, 2)
  reversedCogsAmount   Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  @@map("finished_jewellery_return_lines")
}

// One row per (entityType, calendar year) for human-readable Phase 4
// codes — same atomic-upsert pattern as VoucherSequence/DiamondSequence,
// kept as its own table so Phase 3's DiamondSequence stays untouched.
enum JewellerySequenceType {
  METAL_PURCHASE
  JEWELLERY_JOB
  JEWELLERY_RECEIPT
  FINISHED_JEWELLERY
  // Phase 6
  FINISHED_JEWELLERY_SALE
  FINISHED_JEWELLERY_RETURN
}

model JewellerySequence {
  id           String                @id @default(cuid())
  sequenceType JewellerySequenceType
  yearLabel    String
  lastNumber   Int                   @default(0)

  updatedAt DateTime @updatedAt

  @@unique([sequenceType, yearLabel])
  @@map("jewellery_sequences")
}

// ---------------------------------------------------------------------------
// Phase 5 — Jewellery Costing and Selling-Price Calculation
// ---------------------------------------------------------------------------
//
// Informational only: creating, editing, finalizing, revising, or archiving
// a CostSheet NEVER creates a Voucher/JournalEntry/StockMovement/
// MetalStockMovement of any kind, and never mutates any Phase 1-4 row —
// only ever reads from them (see src/lib/costing/engine.ts, deliberately
// NOT named "posting.ts" like every other module's write engine, so no
// reader ever assumes it touches the accounting ledger).
//
// Two source modes:
//   ACTUAL   — snapshots real, already-posted Phase 3/4 figures from one
//              FinishedJewellery output. Only allowed once that output's
//              parent JewelleryJob is COMPLETED: Phase 4's own
//              receiveFinishedJewellery legitimately keeps retroactively
//              correcting an OPEN job's earlier outputs' otherMaterialCost/
//              totalCost every time a later receipt adds a new output (see
//              the "priorOutputs" reallocation there) — so sourcing from an
//              output whose job isn't finished yet would risk snapshotting
//              a number Phase 4 is still going to change underneath it.
//              This one rule also naturally rejects a cancelled, still-
//              in-progress, partially-received, or Needs-Correction job's
//              outputs, since none of those statuses is COMPLETED.
//   ESTIMATE — a manual, editable quotation built before any manufacturing
//              exists; never reserves or issues real Phase 3/4 stock.
//
// A DRAFT sheet's inputs are fully editable (ACTUAL mode's "Refresh from
// source" re-pulls the latest snapshot on demand — never automatically,
// and only while still DRAFT). Once FINALIZED, every input column is
// frozen forever: a later Metal/Purity, GST-rate, or Costing-Settings
// change can never alter a finalized sheet's stored figures. A correction
// to a finalized sheet is always a NEW revision (a new CostSheet row,
// linked via previousVersionId/revisionGroupId) — never an edit in place.
//
// The full calculation summary (production cost, suggested selling
// price, discount, GST, customer total, profit, margin, ...) is
// deliberately NEVER a stored column here — see
// src/lib/costing/calculations.ts. It is always DERIVED at read time from
// this row's own (already-frozen, once finalized) inputs, the same
// "compute on read from immutable stored facts, never a cached total"
// principle every other module in this codebase already follows
// (pendingFineWeightOf, getMetalStockBalanceInTx, ...) — so a finalized
// sheet's displayed numbers can never drift out of sync with what was
// actually frozen.

enum CostSheetMode {
  ACTUAL
  ESTIMATE
}

enum CostSheetStatus {
  DRAFT
  FINALIZED
  ARCHIVED
}

// Suggested selling value = Production cost x (1 + markup% / 100).
// Never confused with margin — see MARGIN_ON_PRICE below.
enum PricingMethod {
  MARKUP_ON_COST
  // Suggested selling value = Production cost / (1 - margin% / 100).
  // Rejected server-side at margin% >= 100 (division by zero/negative).
  MARGIN_ON_PRICE
}

enum DiscountType {
  NONE
  PERCENT
  FIXED
}

// PERCENT_OF_MATERIAL_COST is deliberately based on metal + diamond +
// other-material cost ONLY (never other charge lines) — so any number of
// percentage-based charge lines on the same sheet can be computed
// independently and simultaneously, with no order-dependency or
// circularity between them. See src/lib/costing/calculations.ts.
enum ChargeMethod {
  FLAT
  PER_GRAM
  PER_CARAT
  PER_PIECE
  PERCENT_OF_MATERIAL_COST
}

enum OtherMaterialCategory {
  MOISSANITE
  COLOURED_STONE
  SMALL_STONE
  FINDINGS
  ALLOY
  ENAMEL
  PLATING
  PACKAGING
  OTHER
}

enum CostSheetEventType {
  CREATED
  UPDATED
  REFRESHED
  FINALIZED
  REVISED
  ARCHIVED
  UNARCHIVED
  DRAFT_DELETED
}

// Financial-year-aware, concurrency-safe numbering (same atomic-upsert
// pattern as VoucherSequence) — kept as its own table, own prefix, so
// Phase 2-4's numbering is never touched by this phase.
model CostingSequence {
  id                 String @id @default(cuid())
  financialYearLabel String @unique
  lastNumber         Int    @default(0)

  updatedAt DateTime @updatedAt

  @@map("costing_sequences")
}

// Owner-only defaults. Singleton row (fixed id "default"), same pattern as
// CompanySettings — no seed-time row is created; code falls back to safe
// defaults when absent (see getCostingSettings). Affects a NEW Draft's
// initial values ONLY — read once at creation time, never re-applied to
// an existing Draft or Finalized sheet.
model CostingSettings {
  id String @id @default("default")

  defaultPricingMethod         PricingMethod @default(MARKUP_ON_COST)
  defaultMarkupPercent         Decimal       @default(0) @db.Decimal(8, 3)
  defaultTargetMarginPercent   Decimal       @default(0) @db.Decimal(8, 3)
  defaultDiscountType          DiscountType  @default(NONE)
  defaultDiscountValue         Decimal       @default(0) @db.Decimal(14, 2)
  defaultGstTreatment          GstTreatment  @default(NONE)
  defaultGstRateId             String?
  defaultGstRate               GstRate?      @relation("CostingSettingsGstRate", fields: [defaultGstRateId], references: [id])
  defaultPriceType             TaxType       @default(EXCLUSIVE)
  defaultValidityDays          Int           @default(15)
  defaultRoundingStep          Decimal       @default(0) @db.Decimal(14, 2)
  defaultSellingExpenseFixed   Decimal       @default(0) @db.Decimal(14, 2)
  defaultSellingExpensePercent Decimal       @default(0) @db.Decimal(8, 3)
  quotationTerms               String?

  updatedByUserId String?
  updatedBy       User?   @relation("CostingSettingsUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("costing_settings")
}

model CostSheet {
  id            String          @id @default(cuid())
  costingNumber String          @unique
  mode          CostSheetMode
  status        CostSheetStatus @default(DRAFT)

  costingDate        DateTime
  jewelleryType      JewelleryType
  itemName           String
  referenceNumber    String?
  quantity           Int           @default(1)
  sizeOrLength       String?
  designImageAssetId String?
  notes              String?

  customerId String?
  customer   Party?  @relation("CostSheetCustomer", fields: [customerId], references: [id])

  // ---- Actual-mode source (null for Estimate) — see file header note. ----
  sourceFinishedJewelleryId String?
  sourceFinishedJewellery   FinishedJewellery? @relation(fields: [sourceFinishedJewelleryId], references: [id])
  sourceJobCode             String?
  sourceReceiptCode         String?
  sourceFinishedCode        String?
  sourceVoucherNumber       String?
  sourceRefreshedAt         DateTime?

  // ---- Optional, Owner-picked (never inferred) link from an ACTUAL sheet
  // back to the ESTIMATE it started from, purely for a variance display. ----
  linkedEstimateId    String?
  linkedEstimate      CostSheet?  @relation("CostSheetEstimateLink", fields: [linkedEstimateId], references: [id])
  actualsFromEstimate CostSheet[] @relation("CostSheetEstimateLink")

  // ---- Pricing / GST — every field below is frozen forever once
  // status becomes FINALIZED; a correction is always a new revision. ----
  pricingMethod              PricingMethod @default(MARKUP_ON_COST)
  markupPercent              Decimal       @default(0) @db.Decimal(8, 3)
  targetMarginPercent        Decimal       @default(0) @db.Decimal(8, 3)
  manualSellingPriceOverride Decimal?      @db.Decimal(14, 2)
  isManualOverride           Boolean       @default(false)
  discountType               DiscountType  @default(NONE)
  discountValue              Decimal       @default(0) @db.Decimal(14, 2)
  gstTreatment               GstTreatment  @default(NONE)
  gstRateId                  String?
  gstRate                    GstRate?      @relation("CostSheetGstRate", fields: [gstRateId], references: [id])
  gstRatePercentSnapshot     Decimal       @default(0) @db.Decimal(5, 2)
  priceType                  TaxType       @default(EXCLUSIVE)
  roundingStep               Decimal       @default(0) @db.Decimal(14, 2)
  sellingExpenseFixed        Decimal       @default(0) @db.Decimal(14, 2)
  sellingExpensePercent      Decimal       @default(0) @db.Decimal(8, 3)
  quotationValidUntil        DateTime?
  quotationTerms             String?

  // ---- Lifecycle / revisions ----
  revisionGroupId   String
  revisionNumber    Int        @default(1)
  previousVersionId String?    @unique
  previousVersion   CostSheet? @relation("CostSheetRevision", fields: [previousVersionId], references: [id])
  nextVersion       CostSheet? @relation("CostSheetRevision")

  finalizedAt       DateTime?
  finalizedByUserId String?
  finalizedBy       User?     @relation("CostSheetFinalizedBy", fields: [finalizedByUserId], references: [id])

  archivedAt       DateTime?
  archivedByUserId String?
  archivedBy       User?     @relation("CostSheetArchivedBy", fields: [archivedByUserId], references: [id])

  idempotencyKey String? @unique

  createdByUserId String
  createdBy       User    @relation("CostSheetCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId String?
  updatedBy       User?   @relation("CostSheetUpdatedBy", fields: [updatedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  metalLines         CostSheetMetalLine[]
  diamondLines       CostSheetDiamondLine[]
  otherMaterialLines CostSheetOtherMaterialLine[]
  chargeLines        CostSheetChargeLine[]
  auditEvents        CostSheetAuditEvent[]

  @@index([mode])
  @@index([status])
  @@index([customerId])
  @@index([costingDate])
  @@index([revisionGroupId])
  @@index([sourceFinishedJewelleryId])
  @@map("cost_sheets")
}

// One line per metal/purity in a costing. ACTUAL mode always has exactly
// one (mirroring its single-purity FinishedJewellery source); ESTIMATE
// mode may have several. wastagePercent/wastageWeight are ALWAYS zero in
// ACTUAL mode — Phase 4's real recognized manufacturing loss is already
// embedded inside the sourced amount (see calculations.ts); they exist
// here only to model an ESTIMATE's own separate, clearly-labelled
// wastage ALLOWANCE, never to be confused with that real, already-
// resolved figure.
model CostSheetMetalLine {
  id          String    @id @default(cuid())
  costSheetId String
  costSheet   CostSheet @relation(fields: [costSheetId], references: [id], onDelete: Cascade)

  metalType                 MetalType
  purityId                  String?
  purity                    MetalPurity? @relation(fields: [purityId], references: [id])
  purityDisplayNameSnapshot String
  finenessPercentSnapshot   Decimal      @db.Decimal(6, 3)

  grossWeight    Decimal @default(0) @db.Decimal(10, 3)
  wastagePercent Decimal @default(0) @db.Decimal(8, 3)
  wastageWeight  Decimal @default(0) @db.Decimal(10, 3)
  fineWeight     Decimal @default(0) @db.Decimal(10, 3)

  rateBasis MetalRateBasis @default(PER_GROSS_GRAM)
  rate      Decimal        @default(0) @db.Decimal(14, 4)

  amount Decimal @default(0) @db.Decimal(14, 2)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([costSheetId])
  @@map("cost_sheet_metal_lines")
}

// One line per diamond (or diamond group) in a costing. ACTUAL mode's
// line(s) mirror the real JewelleryDiamondIssueLine rows resolved SET into
// the source output (sourcePolishedDiamondId set, amount = that diamond's
// own real costAtIssue — never a fixed/rate computation). ESTIMATE mode
// is fully manual (sourcePolishedDiamondId null).
model CostSheetDiamondLine {
  id          String    @id @default(cuid())
  costSheetId String
  costSheet   CostSheet @relation(fields: [costSheetId], references: [id], onDelete: Cascade)

  sourcePolishedDiamondId String?
  sourcePolishedDiamond   PolishedDiamond? @relation(fields: [sourcePolishedDiamondId], references: [id])
  polishedCodeSnapshot    String?

  diamondType     String?
  shape           DiamondShape @default(ROUND)
  customShapeName String?
  quantity        Int          @default(1)
  totalCarat      Decimal      @default(0) @db.Decimal(10, 3)

  ratePerCarat      Decimal? @db.Decimal(14, 2)
  fixedAmount       Decimal? @db.Decimal(14, 2)
  certificateCharge Decimal  @default(0) @db.Decimal(14, 2)

  amount Decimal @default(0) @db.Decimal(14, 2)
  notes  String?

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([costSheetId])
  @@map("cost_sheet_diamond_lines")
}

// Simple manual lines (Moissanite, coloured/small stone, findings, alloy,
// enamel, plating, packaging, other) — never stock-tracked, exactly like
// Phase 4's own JewelleryOtherMaterialLine. ACTUAL mode gets exactly one
// such line, copying the source output's single blended
// FinishedJewellery.otherMaterialCost figure (Phase 4 never breaks that
// figure down per-line at the output level, so this sheet honestly
// reflects the same granularity rather than fabricating a breakdown that
// doesn't exist in the source).
model CostSheetOtherMaterialLine {
  id          String    @id @default(cuid())
  costSheetId String
  costSheet   CostSheet @relation(fields: [costSheetId], references: [id], onDelete: Cascade)

  category    OtherMaterialCategory @default(OTHER)
  description String
  quantity    Decimal?              @db.Decimal(10, 3)
  weight      Decimal?              @db.Decimal(10, 3)
  rate        Decimal?              @db.Decimal(14, 2)
  amount      Decimal               @default(0) @db.Decimal(14, 2)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([costSheetId])
  @@map("cost_sheet_other_material_lines")
}

// Labour / making / CAD / hallmark / certification / setting / packaging /
// shipping / misc charge lines. ACTUAL mode gets exactly one line
// ("Karigar labour & manufacturing charges"), copying the source output's
// single blended FinishedJewellery.labourAllocated figure — Phase 4 only
// tracks labour/making/setting/plating/other-expense as RECEIPT-level
// totals, never broken out per output, so this sheet does not fabricate
// a breakdown Phase 4 never computed. ESTIMATE mode supports any number
// of manually-labelled lines with their own calculation method.
model CostSheetChargeLine {
  id          String    @id @default(cuid())
  costSheetId String
  costSheet   CostSheet @relation(fields: [costSheetId], references: [id], onDelete: Cascade)

  label    String
  // Splits the calculation summary's "Labour cost" (this flag true) from
  // its separate "Additional manufacturing charges" (false) — a display
  // grouping only, freely chosen per line, so any number of lines can be
  // marked either way (e.g. both "Karigar labour" and "Setting labour").
  isLabour Boolean      @default(false)
  method   ChargeMethod @default(FLAT)
  rate     Decimal      @default(0) @db.Decimal(14, 2)
  amount   Decimal      @default(0) @db.Decimal(14, 2)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([costSheetId])
  @@map("cost_sheet_charge_lines")
}

// ---------------------------------------------------------------------------
// Login brute-force protection (V1 final acceptance)
// ---------------------------------------------------------------------------
//
// Persistent, DB-backed rate limiting — see src/lib/auth/rateLimit.ts for
// the full policy and src/app/actions/auth.ts for how it's wired into
// login(). Deliberately never stores a raw email, IP address, or password:
// `keyHash` is an HMAC-SHA256 (keyed with the server-only SESSION_SECRET)
// of a normalized identifier — ACCOUNT buckets on the login email alone,
// NETWORK buckets on the client IP alone (only when a trusted proxy header
// is configured — see getTrustedClientIp()), ACCOUNT_NETWORK combines
// both — so this table can never be read back into a list of real emails
// or IPs even if it were ever exposed.
enum LoginRateLimitBucket {
  ACCOUNT
  NETWORK
  ACCOUNT_NETWORK
}

model LoginRateLimit {
  id           String               @id @default(cuid())
  bucket       LoginRateLimitBucket
  keyHash      String
  failureCount Int                  @default(0)
  windowStart  DateTime
  lockedUntil  DateTime?

  updatedAt DateTime @updatedAt

  @@unique([bucket, keyHash])
  @@index([lockedUntil])
  @@map("login_rate_limits")
}

// Immutable, append-only audit trail — never updated or deleted, same
// principle as StockMovement/MetalStockMovement, applied to a costing's
// lifecycle events instead of a stock ledger.
model CostSheetAuditEvent {
  id          String    @id @default(cuid())
  costSheetId String
  costSheet   CostSheet @relation(fields: [costSheetId], references: [id], onDelete: Cascade)

  eventType CostSheetEventType
  note      String?

  userId String
  user   User   @relation("CostSheetAuditEventUser", fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([costSheetId])
  @@map("cost_sheet_audit_events")
}

// ---------------------------------------------------------------------------
// Phase 7 — Direct Polished Diamond Purchase, Dalal/Broker, packet stock
// ---------------------------------------------------------------------------
//
// Two kinds of polished stock now exist side by side, sharing one "Polished
// Diamond" view while keeping their provenance distinct:
//
//  - PolishedDiamond (Phase 3) — one discrete, individually-costed stone
//    manufactured from a real RoughPiece. Untouched by this phase.
//  - PolishedPacket (here) — a homogeneous packet/batch bought or returned
//    as bulk (pieces + carat, size-wise), the only shape in which melee can
//    honestly be recorded. A purchased packet NEVER invents a parent Rough
//    ID: it simply has none.
//
// A packet's balance is derived by summing its immutable movements, exactly
// like every other stock ledger in this codebase — never a stored column.

enum PolishedRateBasis {
  PER_CARAT
  PER_PIECE
  FIXED_TOTAL
}

enum BrokerageMethod {
  PER_CARAT
  PERCENT
  FIXED
}

/// How a Dalal/Broker's brokerage is treated. Exactly one posting happens
/// per purchase, so brokerage can never be charged twice.
enum BrokerageTreatment {
  /// No broker, or no brokerage on this purchase.
  NONE
  /// Already inside the supplier's own invoice amount — recorded for the
  /// audit trail only; no separate payable.
  INCLUDED_IN_SUPPLIER_COST
  /// Part of the stones' landed cost AND owed to the broker: the inventory
  /// debit includes it and the broker's payable is credited.
  CAPITALISED_PAYABLE_TO_BROKER
  /// Not part of landed cost: Dr Brokerage Expense / Cr the broker's payable.
  EXPENSED_PAYABLE_TO_BROKER
}

enum PolishedProvenance {
  PURCHASED
  MANUFACTURED_FROM_ROUGH
  RETURNED_FROM_JOB
  ADJUSTMENT
  /// Only ever set by a backfill that could not determine the real source —
  /// never guessed from context.
  UNKNOWN_LEGACY
}

enum PolishedPacketStatus {
  ACTIVE
  /// Fully issued/consumed — pieces and carat both zero.
  EMPTY
  CANCELLED
}

enum PolishedPacketMovementType {
  PURCHASE_IN
  PURCHASE_CANCEL_OUT
  PROCESS_ISSUE_OUT
  PROCESS_ISSUE_CANCEL_IN
  PROCESS_RETURN_IN
  JEWELLERY_ISSUE_OUT
  JEWELLERY_ISSUE_CANCEL_IN
  JEWELLERY_RETURN_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

model PolishedPurchase {
  id           String   @id @default(cuid())
  purchaseCode String   @unique
  purchaseDate DateTime

  supplierId String
  supplier   Party  @relation("PolishedPurchaseSupplier", fields: [supplierId], references: [id])

  currencyCode   String  @default("INR")
  exchangeRate   Decimal @default(1) @db.Decimal(10, 4)
  /// Authoritative supplier cost in INR, before GST and before brokerage.
  supplierAmount Decimal @db.Decimal(14, 2)

  gstTreatment   GstTreatment @default(NONE)
  gstRateId      String?
  gstRate        GstRate?     @relation(fields: [gstRateId], references: [id])
  gstRatePercent Decimal?     @db.Decimal(5, 2)

  // ---- Dalal / Broker (all snapshotted, so a later master edit never
  // rewrites this purchase) ----
  brokerPartyId      String?
  broker             Party?             @relation("PolishedPurchaseBroker", fields: [brokerPartyId], references: [id])
  brokerNameSnapshot String?
  brokerageMethod    BrokerageMethod?
  brokerageRate      Decimal?           @db.Decimal(14, 4)
  brokerageAmount    Decimal            @default(0) @db.Decimal(14, 2)
  brokerageTreatment BrokerageTreatment @default(NONE)

  /// What actually enters Polished Diamond Inventory: supplierAmount, plus
  /// brokerage only when it is capitalised. Every line's landedCost sums
  /// back to exactly this.
  landedCost Decimal @db.Decimal(14, 2)

  paymentAccountId String?
  referenceNumber  String?
  notes            String?

  voucherId String?  @unique
  voucher   Voucher? @relation("PolishedPurchaseVoucher", fields: [voucherId], references: [id])

  status                VoucherStatus @default(POSTED)
  cancelledAt           DateTime?
  cancelledByUserId     String?
  cancelledBy           User?         @relation("PolishedPurchaseCancelledBy", fields: [cancelledByUserId], references: [id])
  cancellationReason    String?
  cancellationVoucherId String?       @unique
  cancellationVoucher   Voucher?      @relation("PolishedPurchaseCancellationVoucher", fields: [cancellationVoucherId], references: [id])

  idempotencyKey String? @unique

  createdByUserId String
  createdBy       User   @relation("PolishedPurchaseCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines PolishedPurchaseLine[]

  @@index([supplierId])
  @@index([brokerPartyId])
  @@index([purchaseDate])
  @@map("polished_purchases")
}

/// One packet line on a purchase. Each line creates exactly one
/// PolishedPacket, so the packet keeps the identity that was bought.
model PolishedPurchaseLine {
  id         String           @id @default(cuid())
  purchaseId String
  purchase   PolishedPurchase @relation(fields: [purchaseId], references: [id])

  shape           DiamondShape
  customShapeName String?
  /// Size or size range exactly as traded, e.g. "+2-4", "1.00-1.10mm", "3.5mm".
  sizeLabel       String
  measurements    String?
  pieces          Int
  carat           Decimal      @db.Decimal(10, 3)
  quality         String?
  colour          String?
  lab             String?

  certificateStatus CertificateStatus @default(NOT_CERTIFIED)
  certNumber        String?
  certFileAssetId   String?
  photoAssetId      String?

  rateBasis  PolishedRateBasis @default(PER_CARAT)
  rate       Decimal           @default(0) @db.Decimal(14, 4)
  /// This line's share of the purchase's landed cost.
  landedCost Decimal           @db.Decimal(14, 2)

  notes     String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())

  packet PolishedPacket?

  @@index([purchaseId])
  @@map("polished_purchase_lines")
}

model PolishedPacket {
  id         String             @id @default(cuid())
  packetCode String             @unique
  provenance PolishedProvenance

  /// Grouping key for the aggregated "same stones" view. Packets are never
  /// merged destructively — identical attributes are shown together while
  /// each packet keeps its own identity and cost layer. See
  /// src/lib/diamond/packets.ts.
  mergeKey String

  shape           DiamondShape
  customShapeName String?
  sizeLabel       String
  measurements    String?
  quality         String?
  colour          String?
  lab             String?

  certificateStatus CertificateStatus @default(NOT_CERTIFIED)
  certNumber        String?
  certFileAssetId   String?
  photoAssetId      String?

  currencyCode String @default("INR")

  purchaseLineId String?               @unique
  purchaseLine   PolishedPurchaseLine? @relation(fields: [purchaseLineId], references: [id])

  /// Set when this packet was created by a return that changed the stones'
  /// attributes (e.g. size after polishing), so provenance stays traceable
  /// instead of being averaged into the packet it came from.
  parentPacketId String?
  parentPacket   PolishedPacket?  @relation("PacketParent", fields: [parentPacketId], references: [id])
  childPackets   PolishedPacket[] @relation("PacketParent")

  /// Set when a Job Manufacturer return created this packet.
  sourcePacketProcessJobId String?
  sourcePacketProcessJob   PacketProcessJob? @relation("PacketProcessJobCreatedPackets", fields: [sourcePacketProcessJobId], references: [id])

  status PolishedPacketStatus @default(ACTIVE)
  notes  String?

  createdByUserId String
  createdBy       User   @relation("PolishedPacketCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements           PolishedPacketMovement[]
  jewelleryIssueLines JewelleryPacketIssueLine[]
  processJobLines     PacketProcessJobLine[]

  @@index([mergeKey])
  @@index([status])
  @@index([provenance])
  @@map("polished_packets")
}

/// Immutable, append-only. `pieces`/`carat`/`costValue` are positive
/// magnitudes; direction comes from `type` (…_IN adds, …_OUT removes). A
/// packet's live balance is always the sum of these rows.
model PolishedPacketMovement {
  id   String                     @id @default(cuid())
  type PolishedPacketMovementType

  packetId String
  packet   PolishedPacket @relation(fields: [packetId], references: [id])

  pieces    Int
  carat     Decimal @db.Decimal(10, 3)
  costValue Decimal @db.Decimal(14, 2)

  sourceDocument String

  jewelleryJobId String?
  jewelleryJob   JewelleryJob? @relation(fields: [jewelleryJobId], references: [id])

  packetProcessJobId String?
  packetProcessJob   PacketProcessJob? @relation(fields: [packetProcessJobId], references: [id])

  reversalOfMovementId String?                 @unique
  reversalOfMovement   PolishedPacketMovement? @relation("PacketMovementReversal", fields: [reversalOfMovementId], references: [id])
  reversedByMovement   PolishedPacketMovement? @relation("PacketMovementReversal")

  createdByUserId String
  createdBy       User   @relation("PolishedPacketMovementCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([packetId])
  @@index([type])
  @@index([jewelleryJobId])
  @@index([packetProcessJobId])
  @@map("polished_packet_movements")
}

/// Packet diamonds held by a Jewellery Job. Unlike a discrete stone (which
/// resolves in exactly one state), a packet line resolves progressively by
/// pieces AND carat: set + returned + damaged must equal what was issued
/// before the job can complete.
model JewelleryPacketIssueLine {
  id    String       @id @default(cuid())
  jobId String
  job   JewelleryJob @relation(fields: [jobId], references: [id])

  packetId String
  packet   PolishedPacket @relation(fields: [packetId], references: [id])

  piecesAtIssue Int
  caratAtIssue  Decimal @db.Decimal(10, 3)
  costAtIssue   Decimal @db.Decimal(14, 2)

  setPieces Int     @default(0)
  setCarat  Decimal @default(0) @db.Decimal(10, 3)
  setCost   Decimal @default(0) @db.Decimal(14, 2)

  returnedPieces Int     @default(0)
  returnedCarat  Decimal @default(0) @db.Decimal(10, 3)
  returnedCost   Decimal @default(0) @db.Decimal(14, 2)

  damagedPieces Int     @default(0)
  damagedCarat  Decimal @default(0) @db.Decimal(10, 3)
  damagedCost   Decimal @default(0) @db.Decimal(14, 2)

  /// Set when these stones arrived from a Job Manufacturer return marked
  /// "used in Jewellery Job" rather than a direct issue from stock.
  sourcePacketProcessReceiptLineId String?                   @unique
  sourcePacketProcessReceiptLine   PacketProcessReceiptLine? @relation(fields: [sourcePacketProcessReceiptLineId], references: [id])

  createdAt DateTime @default(now())

  resolutions JewelleryPacketResolution[]

  @@unique([jobId, packetId])
  @@index([jobId])
  @@index([packetId])
  @@map("jewellery_packet_issue_lines")
}

/// One resolution event against a packet issue line, recorded per receipt.
model JewelleryPacketResolution {
  id          String                   @id @default(cuid())
  issueLineId String
  issueLine   JewelleryPacketIssueLine @relation(fields: [issueLineId], references: [id])

  receiptId String
  receipt   JewelleryReceipt @relation(fields: [receiptId], references: [id])

  disposition JewelleryDiamondResolution

  pieces    Int
  carat     Decimal @db.Decimal(10, 3)
  costValue Decimal @db.Decimal(14, 2)

  /// Set when the stones went into a specific finished piece.
  setInFinishedJewelleryId String?
  setInFinishedJewellery   FinishedJewellery? @relation(fields: [setInFinishedJewelleryId], references: [id])

  /// The packet the returned stones went back into — the original packet
  /// when nothing about them changed, otherwise a new child packet.
  resultPacketId String?

  reason String?

  createdAt DateTime @default(now())

  @@index([issueLineId])
  @@index([receiptId])
  @@map("jewellery_packet_resolutions")
}

// ===========================================================================
// Phase 7 P2 — Manufacturer processes and Job Manufacturer (packet process
// jobs). See PHASE_7_IMPROVEMENT_PLAN.md §8.4–8.5.
// ===========================================================================

enum DiamondProcessOutputKind {
  ROUGH
  POLISHED
}

enum ProcessChargeRateBasis {
  FIXED
  PER_CARAT
  PER_PIECE
}

enum PacketProcessJobStatus {
  ISSUED
  PARTIALLY_RETURNED
  COMPLETED
  CANCELLED
}

enum PacketReturnDisposition {
  RETURNED_TO_STOCK
  USED_IN_JEWELLERY_JOB
  DAMAGED_LOST
}

/// Configurable Manufacturer process (4P / Laser, HPHT / Grow, Polishing,
/// Rough Polish, …). HPHT / Grow is an outsourced issue-return-cost process
/// only — there is no in-house growing module.
model DiamondProcess {
  id               String                   @id @default(cuid())
  name             String                   @unique
  outputKind       DiamondProcessOutputKind
  defaultRateBasis ProcessChargeRateBasis   @default(PER_CARAT)
  isActive         Boolean                  @default(true)
  sortOrder        Int                      @default(0)

  createdByUserId String?
  createdBy       User?   @relation("DiamondProcessCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  diamondJobs       DiamondJob[]
  packetProcessJobs PacketProcessJob[]

  @@map("diamond_processes")
}

/// Job Manufacturer: bulk polished packets issued to a Manufacturer for a
/// process and returned size-wise. Every issued piece and carat resolves
/// exactly once; a partial return never recognises loss.
model PacketProcessJob {
  id      String @id @default(cuid())
  jobCode String @unique

  manufacturerId String
  manufacturer   Party  @relation("PacketProcessJobManufacturer", fields: [manufacturerId], references: [id])

  processId           String
  process             DiamondProcess @relation(fields: [processId], references: [id])
  processNameSnapshot String

  issueDate DateTime
  dueDate   DateTime?
  notes     String?

  issuedPieces    Int
  issuedCarat     Decimal @db.Decimal(10, 3)
  issuedCostValue Decimal @db.Decimal(14, 2)

  returnedPieces Int     @default(0)
  returnedCarat  Decimal @default(0) @db.Decimal(10, 3)
  usedPieces     Int     @default(0)
  usedCarat      Decimal @default(0) @db.Decimal(10, 3)
  damagedPieces  Int     @default(0)
  damagedCarat   Decimal @default(0) @db.Decimal(10, 3)
  lossCarat      Decimal @default(0) @db.Decimal(10, 3)

  remainingWipCost Decimal @db.Decimal(14, 2)

  chargeRateBasis ProcessChargeRateBasis
  chargeRate      Decimal                @default(0) @db.Decimal(14, 4)
  totalCharge     Decimal                @default(0) @db.Decimal(14, 2)

  status PacketProcessJobStatus @default(ISSUED)

  wipVoucherId String?  @unique
  wipVoucher   Voucher? @relation("PacketProcessJobWip", fields: [wipVoucherId], references: [id])

  cancelledAt        DateTime?
  cancelledByUserId  String?
  cancelledBy        User?     @relation("PacketProcessJobCancelledBy", fields: [cancelledByUserId], references: [id])
  cancellationReason String?

  idempotencyKey String? @unique

  createdByUserId String
  createdBy       User   @relation("PacketProcessJobCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines          PacketProcessJobLine[]
  receipts       PacketProcessReceipt[]
  movements      PolishedPacketMovement[]
  createdPackets PolishedPacket[]         @relation("PacketProcessJobCreatedPackets")

  @@index([manufacturerId])
  @@index([status])
  @@map("packet_process_jobs")
}

/// One size-wise issued line: stones taken from one packet.
model PacketProcessJobLine {
  id    String           @id @default(cuid())
  jobId String
  job   PacketProcessJob @relation(fields: [jobId], references: [id])

  packetId String
  packet   PolishedPacket @relation(fields: [packetId], references: [id])

  piecesAtIssue Int
  caratAtIssue  Decimal @db.Decimal(10, 3)
  costAtIssue   Decimal @db.Decimal(14, 2)

  resolvedPieces Int     @default(0)
  resolvedCarat  Decimal @default(0) @db.Decimal(10, 3)
  lossCarat      Decimal @default(0) @db.Decimal(10, 3)
  resolvedCost   Decimal @default(0) @db.Decimal(14, 2)
  isClosed       Boolean @default(false)

  /// A line closes when every issued piece is resolved and either the carat
  /// matches exactly or someone explicitly confirmed closing it (recognising
  /// the carat gap as line-level Process Loss). Recorded for audit; a closed
  /// line accepts no further receipts.
  closedAt         DateTime?
  closedByUserId   String?
  closedBy         User?                 @relation("PacketProcessJobLineClosedBy", fields: [closedByUserId], references: [id])
  closingReceiptId String?
  closingReceipt   PacketProcessReceipt? @relation("PacketProcessLineClosingReceipt", fields: [closingReceiptId], references: [id])

  createdAt DateTime @default(now())

  receiptLines PacketProcessReceiptLine[]

  @@unique([jobId, packetId])
  @@index([packetId])
  @@map("packet_process_job_lines")
}

/// One return event against a packet process job.
model PacketProcessReceipt {
  id          String           @id @default(cuid())
  receiptCode String           @unique
  jobId       String
  job         PacketProcessJob @relation(fields: [jobId], references: [id])

  receiveDate        DateTime
  isFinal            Boolean  @default(false)
  lossCarat          Decimal  @default(0) @db.Decimal(10, 3)
  isAbnormalLoss     Boolean  @default(false)
  abnormalLossReason String?
  processCharge      Decimal  @default(0) @db.Decimal(14, 2)
  notes              String?

  postingVoucherId String?  @unique
  postingVoucher   Voucher? @relation("PacketProcessReceiptPosting", fields: [postingVoucherId], references: [id])

  idempotencyKey String? @unique

  createdByUserId String
  createdBy       User   @relation("PacketProcessReceiptCreatedBy", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())

  lines          PacketProcessReceiptLine[]
  closedJobLines PacketProcessJobLine[]     @relation("PacketProcessLineClosingReceipt")

  @@index([jobId])
  @@map("packet_process_receipts")
}

model PacketProcessReceiptLine {
  id        String               @id @default(cuid())
  receiptId String
  receipt   PacketProcessReceipt @relation(fields: [receiptId], references: [id])

  jobLineId String
  jobLine   PacketProcessJobLine @relation(fields: [jobLineId], references: [id])

  disposition PacketReturnDisposition
  pieces      Int
  carat       Decimal                 @db.Decimal(10, 3)
  /// Size as returned — may differ from the issued packet's size.
  sizeLabel   String
  /// Resolved stone cost plus this row's share of the process charge.
  costValue   Decimal                 @db.Decimal(14, 2)
  chargeShare Decimal                 @default(0) @db.Decimal(14, 2)

  resultPacketId String?

  jewelleryJobId String?
  jewelleryJob   JewelleryJob? @relation(fields: [jewelleryJobId], references: [id])

  damagedLostReason String?

  createdAt DateTime @default(now())

  jewelleryIssueLine JewelleryPacketIssueLine?

  @@index([receiptId])
  @@index([jobLineId])
  @@map("packet_process_receipt_lines")
}
