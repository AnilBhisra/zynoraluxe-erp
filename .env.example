# Copy this file to .env (local dev) and fill in real values.
# Never commit the real .env file — it is already listed in .gitignore.

# Pooled connection, used by the running app (transaction-mode pgbouncer
# pooler if using Supabase). Any "@" or other reserved character inside the
# password must be percent-encoded (e.g. "@" -> "%40") or the URL won't parse.
# postgresql://postgres:password@localhost:5432/zynoraluxe?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/zynoraluxe?schema=public"

# Direct (non-pooled) connection, used only by the Prisma CLI for migrations.
# With Supabase this is the session-mode pooler or the direct connection
# string — transaction-mode pooling doesn't support what Migrate needs.
# For a plain local Postgres, this is the same value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/zynoraluxe?schema=public"

# Secret used to sign session tokens, and (reused, not a separate secret)
# to key the HMAC hashes the login rate limiter stores instead of raw
# emails/IPs — see src/lib/auth/rateLimit.ts. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-output-of-openssl-rand--base64-32"

# --- Login rate limiting (optional, set only once the hosting platform is
# known) -----------------------------------------------------------------
# Name of the ONE request header this app should trust as the real client
# IP, for the broader IP-based brute-force protection on top of the
# always-on per-account limit (see src/lib/auth/rateLimit.ts). Leave unset
# in local development and until you know your deployment platform's
# trusted header — an unset/wrong value here is always the SAFE default
# (IP-based limiting is simply skipped; per-account limiting still fully
# applies). Trusting the wrong header lets a client bypass IP-based
# limiting by setting that header itself, so only set this to a header
# your platform's edge/proxy guarantees it overwrites and a client cannot
# spoof — for example (verify against your actual provider's docs before
# enabling): "x-vercel-forwarded-for" (Vercel), "cf-connecting-ip"
# (Cloudflare), "fly-client-ip" (Fly.io), or "x-forwarded-for" ONLY if
# there is exactly one trusted reverse proxy directly in front of this app.
TRUSTED_CLIENT_IP_HEADER=""

# Used only once, by `npm run db:seed`, to create the first Owner account.
# Not read anywhere else and not stored in the database in plain text.
OWNER_EMAIL="owner@example.com"
OWNER_NAME="Owner"
OWNER_PASSWORD="change-this-before-seeding"

NODE_ENV="development"

# --- Phase 3: Diamond media storage (optional) ------------------------
# Not required to use the Diamond module — every non-photo feature works
# without these. When unset, photo/reference-image/certificate-file upload
# fields are simply disabled (never a fake local-disk upload pretending to
# be production-ready). If using Supabase Storage: create a PRIVATE bucket
# (default name below) and use the project's **secret** API key here
# (Project Settings -> API Keys -> secret; the modern successor to the
# legacy service_role key), never the publishable/anon key — this key is
# server-only and must never reach the browser. See
# src/lib/storage/diamondMedia.ts.
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
SUPABASE_DIAMOND_BUCKET="diamond-media"

# --- Phase 4: Jewellery media storage (optional) -----------------------
# Design-image/finished-photo uploads on Jewellery Jobs. Reuses the same
# SUPABASE_URL/SUPABASE_SECRET_KEY above. By default reuses the Diamond
# bucket under jewellery-specific path prefixes (a clearly separated
# private path in an existing bucket) — set this only if you want a
# dedicated bucket instead. See src/lib/storage/jewelleryMedia.ts.
SUPABASE_JEWELLERY_BUCKET=""
